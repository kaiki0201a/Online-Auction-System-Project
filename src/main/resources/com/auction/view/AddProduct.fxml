<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #0A0B0D; -fx-control-inner-background: #0A0B0D; -fx-background: #0A0B0D; -fx-border-color: transparent;"
            stylesheets="@fileCS/add-product.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.AddProductController">

    <VBox alignment="TOP_CENTER" spacing="28.0"
          style="-fx-background-color: linear-gradient(to right,#0A0B0D,#14161A);
                 -fx-border-color: #2D3138;
                 -fx-border-radius: 8;
                 -fx-background-radius: 8;
                 -fx-padding: 40;
                 -fx-max-width: 900;">
        <VBox.margin>
            <Insets bottom="20" left="20" right="20" top="20" />
        </VBox.margin>

        <!-- Header -->
        <VBox spacing="8" style="-fx-border-color: #2D3138; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 20 0;">
            <Label styleClass="header-title" text="Tạo Phiên Đấu Giá Mới" />
            <Label styleClass="header-subtitle" text="Nhập thông tin chi tiết để liệt kê mặt hàng của bạn." />
        </VBox>

        <!-- Tên + Danh mục -->
        <HBox spacing="20.0">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="TÊN MẶT HÀNG" />
                <TextField fx:id="txtName" promptText="Ví dụ: 1969 Ford Mustang Mach 1"
                           styleClass="form-input" />
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="DANH MỤC" />
                <ComboBox fx:id="comboCategory" maxWidth="Infinity" onAction="#onCategoryChange"
                          promptText="Chọn Danh Mục..."
                          style="-fx-background-color: #111111; -fx-border-color: #2A2A2A; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>
        </HBox>

        <!-- Dynamic specs -->
        <VBox fx:id="dynamicSpecContainer" spacing="15" styleClass="spec-box">
        </VBox>

        <!-- Giá + Ngày + Giờ bắt đầu -->
        <HBox spacing="25">
            <VBox prefWidth="250" spacing="8" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="GIÁ KHỞI ĐIỂM (VNĐ)" />
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="price-input-wrapper">
                    <TextField fx:id="txtPrice" promptText="0" styleClass="price-input" HBox.hgrow="ALWAYS" />
                    <Label styleClass="price-prefix" text="VNĐ" />
                </HBox>
            </VBox>
            <VBox prefWidth="250" spacing="8" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="NGÀY BẮT ĐẦU" />
                <DatePicker fx:id="dpStartDate" maxWidth="Infinity" promptText="dd/mm/yyyy"
                            style="-fx-background-color: #111111; -fx-border-color: #2A2A2A; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>
            <VBox prefWidth="250" spacing="8" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="GIỜ BẮT ĐẦU" />
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="price-input-wrapper">
                    <TextField fx:id="txtStartTime" promptText="--:-- --" styleClass="transparent-input" HBox.hgrow="ALWAYS" />
                    <Label styleClass="time-icon" text="🕒" />
                </HBox>
            </VBox>
        </HBox>

        <!-- Upload ảnh -->
        <VBox spacing="10">
            <Label styleClass="field-label" text="HÌNH ẢNH ĐỘ PHÂN GIẢI CAO" />
            <VBox alignment="CENTER" spacing="12" styleClass="upload-area">
                <SVGPath content="M19.35 10.04C18.67 6.59 15.64 4 12 4C9.11 4 6.6 5.64 5.35 8.04C2.34 8.36 0 10.91 0 14C0 17.31 2.69 20 6 20H19C21.76 20 24 17.76 24 15C24 12.36 21.95 10.22 19.35 10.04ZM19 18H6C3.79 18 2 16.21 2 14C2 11.95 3.53 10.24 5.56 10.03L6.63 9.92L7.13 8.97C8.08 7.14 9.94 6 12 6C14.62 6 16.88 7.86 17.39 10.43L17.69 11.93L19.22 12.04C20.78 12.14 22 13.45 22 15C22 16.65 20.65 18 19 18ZM8 13H10.55V16H13.45V13H16L12 9L8 13Z" fill="#FFFFFF" scaleX="1.5" scaleY="1.5" />
                <Label styleClass="upload-title" text="Kéo và thả hình ảnh vào đây">
                    <VBox.margin><Insets top="10" /></VBox.margin>
                </Label>
                <Label styleClass="upload-subtitle" text="Hỗ trợ JPG, PNG chất lượng cao. Tối đa 20MB." />
                <Button onAction="#onBrowseImageClick" styleClass="btn-browse" text="Duyệt File">
                    <VBox.margin><Insets top="10" /></VBox.margin>
                </Button>
            </VBox>
        </VBox>

        <!-- Footer buttons -->
        <VBox spacing="20">
            <Region styleClass="footer-divider">
                <VBox.margin><Insets top="10" /></VBox.margin>
            </Region>
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button onAction="#handleSubmit" styleClass="btn-create" text="Tạo Phiên Đấu Giá" />
            </HBox>
        </VBox>
      <padding>
         <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
      </padding>
    </VBox>
</ScrollPane>
