<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="dark-scroll" stylesheets="@fileCS/add-product.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.AddProductController">

    <VBox styleClass="form-container" spacing="32" alignment="TOP_CENTER">

        <VBox spacing="8">
            <Label text="Tạo Phiên Đấu Giá Mới" styleClass="header-title"/>
            <Label text="Nhập thông tin chi tiết để liệt kê mặt hàng của bạn." styleClass="header-subtitle"/>
            <Region styleClass="divider" VBox.vgrow="NEVER">
                <VBox.margin><Insets top="20" bottom="2"/></VBox.margin>
            </Region>
        </VBox>

        <HBox spacing="24">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="TÊN MẶT HÀNG" styleClass="field-label"/>
                <TextField fx:id="txtName" promptText="Ví dụ: 1969 Ford Mustang Mach 1" styleClass="form-input"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="DANH MỤC" styleClass="field-label"/>
                <ComboBox fx:id="comboCategory" promptText="Chọn Danh Mục..." onAction="#onCategoryChange" styleClass="form-input" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <VBox fx:id="dynamicSpecContainer"/>

        <HBox spacing="24">
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="250">
                <Label text="GIÁ KHỞI ĐIỂM ($)" styleClass="field-label"/>
                <HBox alignment="CENTER_LEFT" styleClass="price-input-wrapper">
                    <Label text="VND" styleClass="price-prefix"/>
                    <TextField fx:id="txtPrice" promptText="0.00" styleClass="price-input" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="250">
                <Label text="NGÀY BẮT ĐẦU" styleClass="field-label"/>
                <DatePicker fx:id="dpStartDate" promptText="dd/mm/yyyy" styleClass="form-input, date-picker-luxury" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="250">
                <Label text="GIỜ BẮT ĐẦU" styleClass="field-label"/>
                <HBox alignment="CENTER_LEFT" styleClass="form-input" spacing="10">
                    <TextField fx:id="txtStartTime" promptText="--:--" styleClass="transparent-input" HBox.hgrow="ALWAYS"/>
                    <Label text="🕒" styleClass="time-icon"/>
                </HBox>
            </VBox>
        </HBox>

        <VBox spacing="8">
            <Label text="HÌNH ẢNH ĐỘ PHÂN GIẢI CAO" styleClass="field-label"/>
            <VBox styleClass="upload-area" alignment="CENTER" spacing="15">
                <SVGPath content="M19.35 10.04C18.67 6.59 15.64 4 12 4C9.11 4 6.6 5.64 5.35 8.04C2.34 8.36 0 10.91 0 14C0 17.31 2.69 20 6 20H19C21.76 20 24 17.76 24 15C24 12.36 21.95 10.22 19.35 10.04ZM19 18H6C3.79 18 2 16.21 2 14C2 11.95 3.53 10.24 5.56 10.03L6.63 9.92L7.13 8.97C8.08 7.14 9.94 6 12 6C14.62 6 16.88 7.86 17.39 10.43L17.69 11.93L19.22 12.04C20.78 12.14 22 13.45 22 15C22 16.65 20.65 18 19 18ZM8 13H10.55V16H13.45V13H16L12 9L8 13Z"
                         fill="#DABD82"/>
                <Label text="Kéo và thả hình ảnh vào đây" styleClass="upload-title"/>
                <Label text="Hỗ trợ JPG, PNG chất lượng cao. Tối đa 20MB." styleClass="upload-subtitle"/>
                <Button text="Duyệt File" styleClass="btn-browse">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Button>
            </VBox>
        </VBox>

        <VBox spacing="30">
            <Region styleClass="footer-divider"/>
            <HBox spacing="24" alignment="CENTER_RIGHT">
                <Button text="Lưu Bản Nháp" styleClass="btn-draft"/>
                <Button text="Tạo Phiên Đấu Giá" styleClass="btn-create"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>