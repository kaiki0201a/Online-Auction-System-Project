<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" stylesheets="@fileCS/add-product.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.AddProductController">

    <ScrollPane fitToWidth="true" styleClass="dark-scroll">
        <VBox alignment="TOP_CENTER" styleClass="page-background">
            <padding><Insets top="36" bottom="36" left="36" right="36"/></padding>

            <!-- ═══════════════ MAIN FORM CONTAINER ═══════════════ -->
            <VBox spacing="28" styleClass="form-container" maxWidth="920">

                <!-- ── HEADER SECTION ─────────────────────────────── -->
                <VBox spacing="6" styleClass="header-section">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <StackPane styleClass="header-icon-wrap" prefWidth="44" prefHeight="44">
                            <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#F5C518" scaleX="1.2" scaleY="1.2"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Tạo Phiên Đấu Giá Mới" styleClass="header-title"/>
                            <Label text="Nhập thông tin chi tiết để liệt kê mặt hàng của bạn." styleClass="header-subtitle"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Region styleClass="divider"/>

                <!-- ── CARD 1: THÔNG TIN CƠ BẢN ──────────────────── -->
                <VBox spacing="20" styleClass="section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <SVGPath content="M20 6H4V4h16v2zm-4 6H8v-2h8v2zm2 6H6v-2h12v2z" fill="#F5C518" scaleX="0.8" scaleY="0.8"/>
                        <Label text="THÔNG TIN CƠ BẢN" styleClass="section-title"/>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="TÊN MẶT HÀNG" styleClass="field-label"/>
                            <TextField fx:id="txtName" promptText="Ví dụ: 1969 Ford Mustang Mach 1" styleClass="form-input"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="DANH MỤC" styleClass="field-label"/>
                            <ComboBox fx:id="comboCategory" promptText="Chọn Danh Mục..." onAction="#onCategoryChange" styleClass="form-input" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="8">
                        <Label text="MÔ TẢ SẢN PHẨM" styleClass="field-label"/>
                        <TextArea fx:id="txtDescription" promptText="Mô tả chi tiết về sản phẩm đấu giá..." styleClass="form-textarea" prefRowCount="4"/>
                    </VBox>
                </VBox>

                <!-- ── DYNAMIC SPEC CONTAINER ─────────────────────── -->
                <VBox fx:id="dynamicSpecContainer" spacing="15" styleClass="spec-box"/>

                <!-- ── CARD 2: GIÁ & THỜI GIAN ───────────────────── -->
                <VBox spacing="20" styleClass="section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="#F5C518" scaleX="0.8" scaleY="0.8"/>
                        <Label text="GIÁ &amp; THỜI GIAN" styleClass="section-title"/>
                    </HBox>

                    <HBox spacing="20">
                        <!-- Giá khởi điểm -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="GIÁ KHỞI ĐIỂM (VNĐ)" styleClass="field-label"/>
                            <HBox alignment="CENTER_LEFT" styleClass="price-input-wrapper">
                                <Label text="₫" styleClass="price-prefix"/>
                                <TextField fx:id="txtPrice" promptText="0" styleClass="price-input" HBox.hgrow="ALWAYS"/>
                                <Label text="VNĐ" styleClass="price-suffix"/>
                            </HBox>
                        </VBox>

                        <!-- Ngày bắt đầu -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="NGÀY BẮT ĐẦU" styleClass="field-label"/>
                            <DatePicker fx:id="dpStartDate" promptText="dd/mm/yyyy" styleClass="form-input" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Giờ bắt đầu -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="GIỜ BẮT ĐẦU" styleClass="field-label"/>
                            <HBox alignment="CENTER_LEFT" styleClass="time-input-wrapper">
                                <TextField fx:id="txtStartTime" promptText="--:-- --" styleClass="transparent-input" HBox.hgrow="ALWAYS"/>
                                <Label text="🕒" styleClass="time-icon"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ── CARD 3: HÌNH ẢNH ──────────────────────────── -->
                <VBox spacing="14" styleClass="section-card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <SVGPath content="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" fill="#F5C518" scaleX="0.8" scaleY="0.8"/>
                        <Label text="HÌNH ẢNH SẢN PHẨM" styleClass="section-title"/>
                    </HBox>

                    <VBox alignment="CENTER" spacing="14" styleClass="upload-area">
                        <SVGPath content="M19.35 10.04C18.67 6.59 15.64 4 12 4C9.11 4 6.6 5.64 5.35 8.04C2.34 8.36 0 10.91 0 14C0 17.31 2.69 20 6 20H19C21.76 20 24 17.76 24 15C24 12.36 21.95 10.22 19.35 10.04ZM19 18H6C3.79 18 2 16.21 2 14C2 11.95 3.53 10.24 5.56 10.03L6.63 9.92L7.13 8.97C8.08 7.14 9.94 6 12 6C14.62 6 16.88 7.86 17.39 10.43L17.69 11.93L19.22 12.04C20.78 12.14 22 13.45 22 15C22 16.65 20.65 18 19 18ZM8 13H10.55V16H13.45V13H16L12 9L8 13Z" fill="#F5C518" scaleX="1.8" scaleY="1.8"/>
                        <Label text="Kéo và thả hình ảnh vào đây" styleClass="upload-title">
                            <VBox.margin><Insets top="12"/></VBox.margin>
                        </Label>
                        <Label text="Hỗ trợ JPG, PNG chất lượng cao. Tối đa 20MB." styleClass="upload-subtitle"/>
                        <Button text="Duyệt File" onAction="#onBrowseImageClick" styleClass="btn-browse">
                            <VBox.margin><Insets top="8"/></VBox.margin>
                        </Button>
                    </VBox>
                </VBox>

                <!-- ── FOOTER ACTIONS ─────────────────────────────── -->
                <VBox spacing="20">
                    <Region styleClass="divider"/>
                    <HBox spacing="16" alignment="CENTER_RIGHT">
                        <Button text="Lưu Bản Nháp" onAction="#onSaveDraftClick" styleClass="btn-draft"/>
                        <Button text="✦  Tạo Phiên Đấu Giá" onAction="#handleSubmit" styleClass="btn-create"/>
                    </HBox>
                </VBox>

            </VBox>
        </VBox>
    </ScrollPane>

</StackPane>