<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.AuctionDetailController">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

    <Label fx:id="lblProductName" styleClass="title-label" text="Tên Sản Phẩm Ở Đây" />

    <GridPane vgap="10" hgap="15">
        <Label text="Người bán:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="lblSellerName" style="-fx-font-weight: bold;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Giá cao nhất hiện tại:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="lblCurrentPrice" style="-fx-text-fill: #e74c3c; -fx-font-size: 18px; -fx-font-weight: bold;" text="\$0.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Thời gian còn lại:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="lblTimeLeft" text="..." GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Separator />

    <VBox spacing="10">
        <Label text="Khu vực trả giá:" style="-fx-font-weight: bold;"/>
        <HBox spacing="10">
            <TextField fx:id="txtBidAmount" promptText="Nhập số tiền ($)..." />
            <Button fx:id="btnPlaceBid" text="Đặt Giá Ngay" styleClass="custom-button"/>
        </HBox>
        <Label fx:id="lblMessage" styleClass="error-label" text="" />
    </VBox>

    <Button fx:id="btnBack" text="Quay lại danh sách" />
</VBox>