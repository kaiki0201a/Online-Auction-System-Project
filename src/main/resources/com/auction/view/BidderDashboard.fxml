<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="800" prefWidth="1280"
            style="-fx-background-color: #0A0B0D;"
            stylesheets="@fileCS/style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.BidderDashboardController">

    <!-- ====== TOP NAVBAR ====== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="24"
              styleClass="navbar-dark"
              prefHeight="72">

            <Label styleClass="brand-logo" text="BIDPRECISION" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Số dư -->
            <VBox alignment="CENTER_RIGHT" spacing="1">
                <Label styleClass="label-caption" text="SỐ DƯ" />
                <Label fx:id="lblHeaderBalance"
                       styleClass="label-gold"
                       style="-fx-font-size: 14px;"
                       text="0 VNĐ" />
            </VBox>

            <!-- Search -->
            <TextField fx:id="txtSearch" prefWidth="240"
                       promptText="🔍  Tìm sản phẩm..."
                       style="-fx-background-color: #15171B;
                       -fx-text-fill: white;
                       -fx-border-color: #2D3138;
                       -fx-border-radius: 20;
                       -fx-background-radius: 20;
                       -fx-padding: 8 15;
                       -fx-prompt-text-fill: #55504A;" />

            <Button onAction="#onSearchClick"
                    styleClass="btn-outline-gold"
                    style="-fx-padding: 8 16;"
                    text="Tìm" />
        </HBox>
    </top>

    <!-- ====== LEFT SIDEBAR ====== -->
    <left>
        <VBox prefWidth="235" spacing="4"
              styleClass="sidebar-dark">

            <!-- Avatar -->
            <HBox alignment="CENTER_LEFT" onMouseClicked="#onAvatarClick" spacing="12"
                  style="-fx-padding: 24 18;
                       -fx-border-color: #2D3138;
                       -fx-border-width: 0 0 1 0;
                       -fx-cursor: hand;">
                <StackPane prefHeight="44" prefWidth="44"
                           styleClass="avatar-circle">
                    <Label fx:id="lblAvatar"
                           styleClass="avatar-initials"
                           text="B" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label fx:id="lblUsername"
                           style="-fx-text-fill: #F5F5F5; -fx-font-size: 14px; -fx-font-weight: bold;"
                           text="Bidder" />
                    <Label styleClass="label-gold"
                           style="-fx-font-size: 10px;"
                           text="⚙ Cài đặt tài khoản" />
                </VBox>
            </HBox>

            <!-- Menu buttons -->
            <Button maxWidth="Infinity" onAction="#onMarketClick"
                    styleClass="menu-btn" style="-fx-text-fill: #E8D06E;" text="🏠  Dashboard">
                <font><Font size="14.0" /></font>
            </Button>
            <Button maxWidth="Infinity" onAction="#onProfileClick"
                    styleClass="menu-btn" style="-fx-text-fill: #E8D06E;" text="👤  Trang Cá Nhân" />
            <Button maxWidth="Infinity" onAction="#onMyAuctionsClick"
                    styleClass="menu-btn" style="-fx-text-fill: #E8D06E;" text="🏆  Phiên Đang Tham Gia" />

            <Separator style="-fx-background-color: #2D3138;" />

            <Label styleClass="label-caption"
                   style="-fx-padding: 6 20 2 20;"
                   text="VÍ ĐIỆN TỬ" />

            <Button maxWidth="Infinity" onAction="#onDepositClick"
                    styleClass="menu-btn" style="-fx-text-fill: #E8D06E;" text="⬆  Nạp Tiền" />
            <Button maxWidth="Infinity" onAction="#onWithdrawClick"
                    styleClass="menu-btn" style="-fx-text-fill: #E8D06E;" text="⬇  Rút Tiền" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#onSettingsClick"
                    styleClass="menu-btn" style="-fx-text-fill: #E8D06E;" text="⚙️  Setting" />

            <!-- Logout -->
            <Button maxWidth="Infinity" onAction="#onLogoutClick"
                    styleClass="menu-btn"
                    style="-fx-text-fill: #B8B0A0;"
                    text="⎋  Đăng Xuất">
                <VBox.margin><Insets bottom="15" /></VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ====== CENTER CONTENT ====== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0A0B0D; -fx-background-color: #0A0B0D;"
                    styleClass="scroll-pane">
            <VBox spacing="30" style="-fx-padding: 32 38;">

                <!-- Welcome + Balance card -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblWelcome"
                               styleClass="label-page-title"
                               text="Chào mừng trở lại 👋" />
                        <Label fx:id="lblStat"
                               styleClass="label-gold"
                               style="-fx-font-size: 15px;"
                               text="Thị trường đang hoạt động." />
                    </VBox>

                    <!-- Balance card -->
                    <VBox alignment="CENTER_RIGHT" prefHeight="128.0" prefWidth="268.0" spacing="8"
                          styleClass="balance-card">
                        <Label prefHeight="17.0" prefWidth="239.0"
                               styleClass="label-caption"
                               text="SỐ DƯ KHẢ DỤNG" />
                        <Label fx:id="lblMainBalance" prefHeight="31.0" prefWidth="239.0"
                               style="-fx-text-fill: #E8D06E; -fx-font-size: 26px; -fx-font-weight: 800;"
                               text="0 VNĐ" />
                        <HBox alignment="CENTER" spacing="8">
                            <Button onAction="#onDepositClick" prefHeight="30.0" prefWidth="106.0"
                                    styleClass="btn-outline-gold"
                                    style="-fx-padding: 5 14;"
                                    text="Nạp Tiền" />
                            <Button onAction="#onWithdrawClick" opacity="0.69" prefHeight="30.0" prefWidth="104.0"
                                    styleClass="btn-outline"
                                    style="-fx-padding: 5 14;"
                                    text="Rút Tiền" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ===== Đấu giá nổi bật ===== -->
                <VBox spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="label-section-title"
                               style="-fx-font-size: 20px;"
                               text="⚈  Đấu Giá Trực Tiếp">
                            <font><Font size="15.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="comboCategory" promptText="Danh mục"
                                  style="-fx-background-color: #15171B;
                                   -fx-text-fill: white;
                                   -fx-border-color: #2D3138;
                                   -fx-border-radius: 4;
                                   -fx-pref-width: 140;" />
                        <Button onAction="#onViewAllAuctions"
                                styleClass="btn-outline-gold"
                                style="-fx-padding: 7 18;"
                                text="Xem tất cả →" />
                    </HBox>
                    <HBox fx:id="liveAuctionsContainer" alignment="TOP_LEFT" minHeight="200" spacing="18" />
                </VBox>

                <!-- ===== Lịch sử đặt giá ===== -->
                <VBox spacing="14" styleClass="card-dark">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="label-section-title"
                               text="📜  Lịch Sử Đặt Giá Gần Đây" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#onViewAllAuctions"
                                styleClass="btn-text-gold"
                                text="Tất cả phiên →" />
                    </HBox>

                    <!-- TableView -->
                    <TableView fx:id="tableRecentBids" prefHeight="230"
                               style="-fx-background-color: transparent;
                               -fx-border-color: #2D3138;
                               -fx-border-radius: 4;">
                        <columns>
                            <TableColumn fx:id="colItem"  prefWidth="288" text="Sản Phẩm" />
                            <TableColumn fx:id="colDate"  prefWidth="172" text="Thời Gian" />
                            <TableColumn fx:id="colAmount" prefWidth="233" text="Số Tiền" />
                            <TableColumn fx:id="colStatus" prefWidth="216" text="Kết Quả" />
                        </columns>
                        <placeholder>
                            <Label styleClass="label-sub"
                                   text="Chưa có lịch sử đặt giá nào." />
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
