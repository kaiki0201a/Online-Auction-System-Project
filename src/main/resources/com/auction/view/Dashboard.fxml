<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.DashboardController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label styleClass="header-title" text="SÀN ĐẤU GIÁ ONLINE" />
        <Region HBox.hgrow="ALWAYS" />

        <ComboBox fx:id="comboCategory" promptText="Tất cả danh mục" prefWidth="130" styleClass="combo-box"/>

        <TextField fx:id="txtSearch" promptText="Tìm kiếm sản phẩm..." prefWidth="200" styleClass="text-field"/>

        <Button fx:id="btnSearch" text="Tìm" styleClass="button, btn-primary"/>
        <Button fx:id="btnCreateAuction" onAction="#onCreateAuctionClick" text="Đăng sản phẩm" styleClass="button, btn-success"/>
        <Button fx:id="btnProfile" onAction="#onProfileClick" text="Trang cá nhân" styleClass="button"/>
    </HBox>

    <TableView fx:id="tableAuctions" onMouseClicked="#onTableClick" VBox.vgrow="ALWAYS">        <columns>
            <TableColumn fx:id="colId" text="Mã Phiên" prefWidth="100"/>
            <TableColumn fx:id="colProductName" text="Tên Sản Phẩm" prefWidth="200"/>
            <TableColumn fx:id="colCurrentPrice" text="Giá Hiện Tại" prefWidth="150"/>
            <TableColumn fx:id="colEndTime" text="Thời Gian Kết Thúc" prefWidth="150"/>
            <TableColumn fx:id="colStatus" text="Trạng Thái" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnViewDetail" text="Xem Chi Tiết &amp; Đấu Giá" styleClass="custom-button"/>
    </HBox>
</VBox>