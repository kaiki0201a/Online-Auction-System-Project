<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" style="-fx-background-color: #0A0B0D;"
           stylesheets="@fileCS/style.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.DepositWithdrawController">

    <VBox alignment="TOP_CENTER" spacing="0" style="-fx-background-color: #0A0B0D;">

        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="navbar-dark" prefHeight="58">
            <Button onAction="#onBackClick" styleClass="btn-back" text="← Quay Lại" />
            <Label styleClass="brand-logo" style="-fx-font-size: 18px;" text="BIDPRECISION" />
            <Label styleClass="label-caption" text="·" />
            <Label styleClass="label-section-title" text="Quản Lý Ví" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox spacing="20" style="-fx-padding: 28 36;">

                <!-- ===== CARD SỐ DƯ ===== -->
                <HBox spacing="16">
                    <!-- Số dư khả dụng -->
                    <VBox spacing="6"
                          styleClass="card-dark"
                          style="-fx-border-color: #E8D06E;"
                          HBox.hgrow="ALWAYS">
                        <Label styleClass="label-caption" text="💰  SỐ DƯ KHẢ DỤNG" />
                        <Label fx:id="lblCurrentBalance" styleClass="label-gold" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="0 ₫" />
                        <Label fx:id="lblUsername" styleClass="label-caption" text="..." />
                    </VBox>
                    <!-- Tổng đã nạp -->
                    <VBox prefWidth="160" spacing="6"
                          style="-fx-background-color: rgba(39,174,96,0.06);
                                 -fx-border-color: #27AE60;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-padding: 20;">
                        <Label style="-fx-text-fill: #4CAF50; -fx-font-size: 10px; -fx-font-weight: bold;" text="⬆  TỔNG ĐÃ NẠP" />
                        <Label fx:id="lblTotalDeposit" style="-fx-text-fill: #4CAF50; -fx-font-size: 18px; -fx-font-weight: bold;" text="0 ₫" />
                        <Label fx:id="lblDepositCount" style="-fx-text-fill: #27AE60; -fx-font-size: 11px;" text="0 giao dịch" />
                    </VBox>
                    <!-- Tổng đã rút -->
                    <VBox prefWidth="160" spacing="6"
                          style="-fx-background-color: rgba(231,76,60,0.06);
                                 -fx-border-color: #E74C3C;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-padding: 20;">
                        <Label style="-fx-text-fill: #e74c3c; -fx-font-size: 10px; -fx-font-weight: bold;" text="⬇  TỔNG ĐÃ RÚT" />
                        <Label fx:id="lblTotalWithdraw" style="-fx-text-fill: #e74c3c; -fx-font-size: 18px; -fx-font-weight: bold;" text="0 ₫" />
                        <Label fx:id="lblWithdrawCount" style="-fx-text-fill: #922B21; -fx-font-size: 11px;" text="0 giao dịch" />
                    </VBox>
                </HBox>

                <!-- ===== FORM NẠP / RÚT ===== -->
                <HBox spacing="16">

                    <!-- ── Nạp tiền ── -->
                    <VBox spacing="14" styleClass="card-dark" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #4CAF50; -fx-font-size: 20px;" text="⬆" />
                            <Label style="-fx-text-fill: #4CAF50; -fx-font-size: 14px; -fx-font-weight: bold;" text="NẠP TIỀN" />
                        </HBox>

                        <Label styleClass="label-caption" text="SỐ TIỀN MUỐN NẠP" />
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrapper" style="-fx-padding: 0 12 0 16;">
                            <Label style="-fx-text-fill: #4CAF50; -fx-font-size: 16px; -fx-font-weight: bold;" text="₫" />
                            <TextField fx:id="txtDepositAmount" promptText="Nhập số tiền..."
                                       styleClass="input-transparent"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold;"
                                       HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Nút nhanh nạp -->
                        <HBox spacing="8">
                            <Button maxWidth="Infinity" onAction="#onDepositQuick100k"
                                    styleClass="deposit-quick-btn" text="+100K" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#onDepositQuick500k"
                                    styleClass="deposit-quick-btn" text="+500K" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#onDepositQuick1M"
                                    styleClass="deposit-quick-btn" text="+1M" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#onDepositQuick5M"
                                    styleClass="deposit-quick-btn" text="+5M" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Label fx:id="lblDepositMessage" style="-fx-font-size: 12px;" text="" wrapText="true" />

                        <Button fx:id="btnDeposit" maxWidth="Infinity" onAction="#onDepositClick"
                                styleClass="btn-success"
                                style="-fx-padding: 13; -fx-font-size: 14px;"
                                text="✅  XÁC NHẬN NẠP TIỀN">
                        </Button>
                    </VBox>

                    <!-- ── Rút tiền ── -->
                    <VBox spacing="14" styleClass="card-dark" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #e74c3c; -fx-font-size: 20px;" text="⬇" />
                            <Label style="-fx-text-fill: #e74c3c; -fx-font-size: 14px; -fx-font-weight: bold;" text="RÚT TIỀN" />
                        </HBox>

                        <Label styleClass="label-caption" text="SỐ TIỀN MUỐN RÚT" />
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrapper" style="-fx-padding: 0 12 0 16;">
                            <Label style="-fx-text-fill: #e74c3c; -fx-font-size: 16px; -fx-font-weight: bold;" text="₫" />
                            <TextField fx:id="txtWithdrawAmount" promptText="Nhập số tiền..."
                                       styleClass="input-transparent"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold;"
                                       HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Nút nhanh rút -->
                        <HBox spacing="8">
                            <Button maxWidth="Infinity" onAction="#onWithdrawQuick100k"
                                    styleClass="withdraw-quick-btn" text="-100K" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#onWithdrawQuick500k"
                                    styleClass="withdraw-quick-btn" text="-500K" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#onWithdrawQuick1M"
                                    styleClass="withdraw-quick-btn" text="-1M" HBox.hgrow="ALWAYS" />
                            <Button maxWidth="Infinity" onAction="#onWithdrawQuick5M"
                                    styleClass="withdraw-quick-btn" text="-5M" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Label fx:id="lblWithdrawMessage" style="-fx-font-size: 12px;" text="" wrapText="true" />

                        <Button fx:id="btnWithdraw" maxWidth="Infinity" onAction="#onWithdrawClick"
                                styleClass="btn-danger"
                                style="-fx-padding: 13; -fx-font-size: 14px;"
                                text="💸  XÁC NHẬN RÚT TIỀN">
                        </Button>
                    </VBox>

                </HBox>

                <!-- ===== LỊCH SỬ GIAO DỊCH ===== -->
                <VBox spacing="12" styleClass="card-dark">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="label-section-title" text="📋  LỊCH SỬ GIAO DỊCH" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalTx" styleClass="label-caption" text="0 giao dịch" />
                    </HBox>
                    <Separator style="-fx-background-color: #2D3138;" />
                    <!-- Header bảng -->
                    <HBox style="-fx-padding: 0 4;">
                        <Label prefWidth="130" styleClass="label-caption" text="THỜI GIAN" />
                        <Label prefWidth="100" styleClass="label-caption" text="LOẠI" />
                        <Label styleClass="label-caption" text="SỐ TIỀN" HBox.hgrow="ALWAYS" />
                        <Label prefWidth="160" styleClass="label-caption"
                               style="-fx-alignment: CENTER_RIGHT;"
                               text="SỐ DƯ SAU" />
                    </HBox>
                    <!-- Danh sách giao dịch -->
                    <ScrollPane fitToWidth="true" prefHeight="220" styleClass="scroll-pane">
                        <VBox fx:id="historyContainer" spacing="6" />
                    </ScrollPane>
                    <Label styleClass="label-caption"
                           style="-fx-font-style: italic;"
                           text="⚠  Hệ thống sử dụng tiền ảo mô phỏng. Không liên quan đến giao dịch thật." />
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
