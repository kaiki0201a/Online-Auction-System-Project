<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
    stylesheets="@fileCS/style.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.auction.controller.DepositWithdrawController"
    style="-fx-background-color: #0d0d0d;">

    <VBox spacing="0" alignment="TOP_CENTER" style="-fx-background-color: #0d0d0d;">

        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT" spacing="15"
            style="-fx-background-color: #0F0F0F; -fx-border-color: #2A2A2A; -fx-border-width: 0 0 1 0; -fx-padding: 14 28;">
            <Button onAction="#onBackClick"
                style="-fx-background-color: transparent; -fx-text-fill: #F5C518; -fx-font-size: 15px; -fx-cursor: hand;"
                text="← Quay Lại"/>
            <Label style="-fx-text-fill: #F5C518; -fx-font-size: 18px; -fx-font-weight: 900; -fx-font-family: 'Arial Black';"
                text="SUPERBID"/>
            <Label style="-fx-text-fill: #555; -fx-font-size: 14px;" text="·"/>
            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"
                text="Quản Lý Ví"/>
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox spacing="20" style="-fx-padding: 28 36;">

                <!-- ===== CARD SỐ DƯ ===== -->
                <HBox spacing="16">
                    <!-- Số dư khả dụng -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #171717; -fx-border-color: #F5C518; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label text="💰  SỐ DƯ KHẢ DỤNG"
                            style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCurrentBalance" text="0 ₫"
                            style="-fx-text-fill: #F5C518; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblUsername" text="..."
                            style="-fx-text-fill: #555; -fx-font-size: 11px;"/>
                    </VBox>
                    <!-- Tổng đã nạp -->
                    <VBox spacing="6" prefWidth="160"
                        style="-fx-background-color: #0F1F0F; -fx-border-color: #1E4D1E; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label text="⬆  TỔNG ĐÃ NẠP"
                            style="-fx-text-fill: #4CAF50; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalDeposit" text="0 ₫"
                            style="-fx-text-fill: #4CAF50; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblDepositCount" text="0 giao dịch"
                            style="-fx-text-fill: #2E7D32; -fx-font-size: 11px;"/>
                    </VBox>
                    <!-- Tổng đã rút -->
                    <VBox spacing="6" prefWidth="160"
                        style="-fx-background-color: #1F0F0F; -fx-border-color: #4D1E1E; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label text="⬇  TỔNG ĐÃ RÚT"
                            style="-fx-text-fill: #e74c3c; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalWithdraw" text="0 ₫"
                            style="-fx-text-fill: #e74c3c; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblWithdrawCount" text="0 giao dịch"
                            style="-fx-text-fill: #922B21; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <!-- ===== FORM NẠP / RÚT ===== -->
                <HBox spacing="16">

                    <!-- ── Nạp tiền ── -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 22;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⬆" style="-fx-text-fill: #4CAF50; -fx-font-size: 20px;"/>
                            <Label text="NẠP TIỀN"
                                style="-fx-text-fill: #4CAF50; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>

                        <Label text="SỐ TIỀN MUỐN NẠP"
                            style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <HBox alignment="CENTER_LEFT"
                            style="-fx-background-color: #1a1a1a; -fx-border-color: #333; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12 0 16;">
                            <Label text="₫" style="-fx-text-fill: #4CAF50; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <TextField fx:id="txtDepositAmount" promptText="Nhập số tiền..."
                                style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white; -fx-prompt-text-fill: #444; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 10;"
                                HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <!-- Nút nhanh nạp -->
                        <HBox spacing="8">
                            <Button onAction="#onDepositQuick100k" text="+100K"
                                style="-fx-background-color: #0F2010; -fx-text-fill: #4CAF50; -fx-border-color: #1E4D1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button onAction="#onDepositQuick500k" text="+500K"
                                style="-fx-background-color: #0F2010; -fx-text-fill: #4CAF50; -fx-border-color: #1E4D1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button onAction="#onDepositQuick1M" text="+1M"
                                style="-fx-background-color: #0F2010; -fx-text-fill: #4CAF50; -fx-border-color: #1E4D1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button onAction="#onDepositQuick5M" text="+5M"
                                style="-fx-background-color: #0F2010; -fx-text-fill: #4CAF50; -fx-border-color: #1E4D1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <Label fx:id="lblDepositMessage" text=""
                            style="-fx-font-size: 12px;" wrapText="true"/>

                        <Button fx:id="btnDeposit" onAction="#onDepositClick" maxWidth="Infinity"
                            text="✅  XÁC NHẬN NẠP TIỀN"
                            style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 13;">
                        </Button>
                    </VBox>

                    <!-- ── Rút tiền ── -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 22;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⬇" style="-fx-text-fill: #e74c3c; -fx-font-size: 20px;"/>
                            <Label text="RÚT TIỀN"
                                style="-fx-text-fill: #e74c3c; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>

                        <Label text="SỐ TIỀN MUỐN RÚT"
                            style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <HBox alignment="CENTER_LEFT"
                            style="-fx-background-color: #1a1a1a; -fx-border-color: #333; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12 0 16;">
                            <Label text="₫" style="-fx-text-fill: #e74c3c; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <TextField fx:id="txtWithdrawAmount" promptText="Nhập số tiền..."
                                style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white; -fx-prompt-text-fill: #444; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 10;"
                                HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <!-- Nút nhanh rút -->
                        <HBox spacing="8">
                            <Button onAction="#onWithdrawQuick100k" text="-100K"
                                style="-fx-background-color: #200F0F; -fx-text-fill: #e74c3c; -fx-border-color: #4D1E1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button onAction="#onWithdrawQuick500k" text="-500K"
                                style="-fx-background-color: #200F0F; -fx-text-fill: #e74c3c; -fx-border-color: #4D1E1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button onAction="#onWithdrawQuick1M" text="-1M"
                                style="-fx-background-color: #200F0F; -fx-text-fill: #e74c3c; -fx-border-color: #4D1E1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button onAction="#onWithdrawQuick5M" text="-5M"
                                style="-fx-background-color: #200F0F; -fx-text-fill: #e74c3c; -fx-border-color: #4D1E1E; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <Label fx:id="lblWithdrawMessage" text=""
                            style="-fx-font-size: 12px;" wrapText="true"/>

                        <Button fx:id="btnWithdraw" onAction="#onWithdrawClick" maxWidth="Infinity"
                            text="💸  XÁC NHẬN RÚT TIỀN"
                            style="-fx-background-color: #922B21; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 13;">
                        </Button>
                    </VBox>

                </HBox>

                <!-- ===== LỊCH SỬ GIAO DỊCH ===== -->
                <VBox spacing="12"
                    style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋  LỊCH SỬ GIAO DỊCH"
                            style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotalTx" text="0 giao dịch"
                            style="-fx-text-fill: #555; -fx-font-size: 11px;"/>
                    </HBox>
                    <Separator style="-fx-background-color: #2A2A2A;"/>
                    <!-- Header bảng -->
                    <HBox style="-fx-padding: 0 4;">
                        <Label text="THỜI GIAN" prefWidth="130"
                            style="-fx-text-fill: #555; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label text="LOẠI" prefWidth="100"
                            style="-fx-text-fill: #555; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label text="SỐ TIỀN" HBox.hgrow="ALWAYS"
                            style="-fx-text-fill: #555; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        <Label text="SỐ DƯ SAU" prefWidth="160"
                            style="-fx-text-fill: #555; -fx-font-size: 10px; -fx-font-weight: bold; -fx-alignment: CENTER_RIGHT;"/>
                    </HBox>
                    <!-- Danh sách giao dịch -->
                    <ScrollPane fitToWidth="true" prefHeight="220" styleClass="scroll-pane">
                        <VBox fx:id="historyContainer" spacing="6"/>
                    </ScrollPane>
                    <Label text="⚠  Hệ thống sử dụng tiền ảo mô phỏng. Không liên quan đến giao dịch thật."
                        style="-fx-text-fill: #333; -fx-font-size: 10px; -fx-font-style: italic;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
