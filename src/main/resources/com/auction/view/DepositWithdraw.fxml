<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" stylesheets="@fileCS/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.DepositWithdrawController">

    <VBox prefWidth="500.0" prefHeight="400.0" style="-fx-background-color: #0d0d0d;" alignment="CENTER">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #0F0F0F; -fx-border-color: #2A2A2A; -fx-border-width: 0 0 1 0; -fx-padding: 15 30;">
            <Button onAction="#onBackClick" style="-fx-background-color: transparent; -fx-text-fill: #F5C518; -fx-font-size: 16px; -fx-cursor: hand;" text="← Quay Lại" />
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Nạp / Rút Tiền" />
        </HBox>

        <!-- Main Content -->
        <VBox spacing="25.0" VBox.vgrow="ALWAYS" style="-fx-padding: 30 40;">

            <!-- Thông tin ví -->
            <VBox spacing="10.0" style="-fx-background-color: #171717; -fx-border-color: #F5C518; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label style="-fx-text-fill: #F5C518; -fx-font-size: 28px;" text="💳" />
                    <VBox spacing="3">
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 11px; -fx-font-weight: bold;" text="TÀI KHOẢN" />
                        <Label fx:id="lblUsername" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="..." />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox spacing="3" alignment="CENTER_RIGHT">
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 11px; -fx-font-weight: bold;" text="SỐ DƯ HIỆN TẠI" />
                        <Label fx:id="lblCurrentBalance" style="-fx-text-fill: #F5C518; -fx-font-size: 22px; -fx-font-weight: bold;" text="..." />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Nhập số tiền -->
            <VBox spacing="8.0">
                <Label style="-fx-text-fill: #e0e0e0; -fx-font-size: 11px; -fx-font-weight: bold;" text="SỐ TIỀN GIAO DỊCH (tối đa 1,000,000,000)" />
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 15;">
                    <Label style="-fx-text-fill: #F5C518; -fx-font-size: 16px; -fx-font-weight: bold;" text="\$ " />
                    <TextField fx:id="txtAmount" promptText="Nhập số tiền..."
                        style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 11 10;"
                        HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- Các nút nhanh -->
            <HBox spacing="10" alignment="CENTER">
                <Button onAction="#onQuick100k" style="-fx-background-color: #1a1a1a; -fx-text-fill: #A0A0A0; -fx-border-color: #333; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 7 15;" text="+100K" />
                <Button onAction="#onQuick500k" style="-fx-background-color: #1a1a1a; -fx-text-fill: #A0A0A0; -fx-border-color: #333; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 7 15;" text="+500K" />
                <Button onAction="#onQuick1M" style="-fx-background-color: #1a1a1a; -fx-text-fill: #A0A0A0; -fx-border-color: #333; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 7 15;" text="+1M" />
                <Button onAction="#onQuick5M" style="-fx-background-color: #1a1a1a; -fx-text-fill: #A0A0A0; -fx-border-color: #333; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 7 15;" text="+5M" />
            </HBox>

            <!-- Thông báo kết quả -->
            <Label fx:id="lblMessage" text="" style="-fx-font-size: 13px;" />

            <!-- Các nút hành động -->
            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="btnDeposit" maxWidth="Infinity" onAction="#onDepositClick" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand;"
                    text="⬆  Nạp Tiền">
                    <padding><Insets bottom="12.0" top="12.0" /></padding>
                </Button>
                <Button fx:id="btnWithdraw" maxWidth="Infinity" onAction="#onWithdrawClick" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-cursor: hand;"
                    text="⬇  Rút Tiền">
                    <padding><Insets bottom="12.0" top="12.0" /></padding>
                </Button>
            </HBox>

            <Label style="-fx-text-fill: #555; -fx-font-size: 11px; -fx-font-style: italic;" text="⚠ Hệ thống sử dụng tiền ảo mô phỏng. Không liên quan đến giao dịch thật." />
        </VBox>
    </VBox>
</StackPane>
