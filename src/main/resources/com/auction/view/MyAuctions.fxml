<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="800" prefWidth="1280"
            styleClass="dark-root"
            stylesheets="@fileCS/style.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.MyAuctionsController">

    <!-- ====== TOP NAVBAR ====== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar-dark" prefHeight="58">
            <Button onAction="#onBackClick"
                    styleClass="btn-back"
                    style="-fx-border-color: #2D3138; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 14;"
                    text="← Quay Lại" />
            <Label style="-fx-font-size: 22px;" text="🏆" />
            <Label styleClass="label-section-title" style="-fx-font-size: 18px;" text="PHIÊN ĐẤU GIÁ ĐANG THAM GIA" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblCount" styleClass="label-caption" text="(0 phiên)" />
        </HBox>
    </top>

    <!-- ====== CENTER CONTENT ====== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20" style="-fx-padding: 30 36;">

                <!-- Filter bar -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="label-sub" text="Lọc:" />
                    <ComboBox fx:id="comboFilter" prefWidth="200"
                              style="-fx-background-color: #15171B; -fx-text-fill: white; -fx-border-color: #2D3138; -fx-border-radius: 10;" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Stats cards -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox alignment="CENTER" prefWidth="220" spacing="6"
                          styleClass="stat-mini-card"
                          style="-fx-border-color: #E8D06E;">
                        <Label styleClass="label-caption" text="ĐANG DẪN ĐẦU" />
                        <Label fx:id="lblLeading" style="-fx-text-fill: #27ae60; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="220" spacing="6"
                          styleClass="stat-mini-card"
                          style="-fx-border-color: #e74c3c;">
                        <Label styleClass="label-caption" text="ĐANG BỊ VƯỢT" />
                        <Label fx:id="lblOutbid" style="-fx-text-fill: #e74c3c; -fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="220" spacing="6"
                          styleClass="stat-mini-card"
                          style="-fx-border-color: #27ae60;">
                        <Label styleClass="label-caption" text="ĐÃ THẮNG" />
                        <Label fx:id="lblWon" styleClass="label-gold" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="0" />
                    </VBox>
                </HBox>

                <!-- Auction table -->
                <VBox spacing="14" styleClass="card-dark">
                    <Label styleClass="label-section-title" text="📋  DANH SÁCH PHIÊN" />
                    <TableView fx:id="tableAuctions" prefHeight="500"
                               style="-fx-background-color: transparent; -fx-border-color: #2D3138; -fx-border-radius: 4;">
                        <columns>
                            <TableColumn fx:id="colItem" prefWidth="280" text="Sản Phẩm" />
                            <TableColumn fx:id="colStatus" prefWidth="140" text="Trạng Thái" />
                            <TableColumn fx:id="colMyBid" prefWidth="150" text="Giá Tôi Đặt" />
                            <TableColumn fx:id="colCurrentBid" prefWidth="150" text="Giá Hiện Tại" />
                            <TableColumn fx:id="colEndTime" prefWidth="204.0" text="Kết Thúc" />
                            <TableColumn fx:id="colAction" prefWidth="224.5" text="Hành Động" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="14" style="-fx-padding: 40;">
                                <Label style="-fx-font-size: 36px;" text="🏆" />
                                <Label styleClass="label-caption" style="-fx-font-size: 14px;" text="Bạn chưa tham gia phiên đấu giá nào." />
                                <Label styleClass="label-caption" text="Hãy vào Thị Trường để tham gia đấu giá!" />
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
