<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" styleClass="dark-root"
    stylesheets="@fileCS/style.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.auction.controller.MyBidsController">

    <VBox prefWidth="1100.0" prefHeight="750.0" style="-fx-background-color: #0d0d0d;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16"
            style="-fx-background-color: #0F0F0F; -fx-border-color: #2A2A2A; -fx-border-width: 0 0 1 0; -fx-padding: 16 30;">
            <Button onAction="#onBackClick"
                style="-fx-background-color: transparent; -fx-text-fill: #F5C518; -fx-font-size: 14px; -fx-cursor: hand; -fx-border-color: #2A2A2A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 14;"
                text="← Quay Lại"/>
            <Label text="🏷" style="-fx-text-fill: #F5C518; -fx-font-size: 22px;"/>
            <VBox spacing="2">
                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                    text="Phiên Đấu Giá Đang Tham Gia"/>
                <Label fx:id="lblSubtitle"
                    style="-fx-text-fill: #666; -fx-font-size: 12px;"
                    text="Theo dõi các phiên đấu giá bạn đã đặt giá"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Balance -->
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="VÍ CỦA BẠN" style="-fx-text-fill: #555; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Label fx:id="lblBalance"
                    style="-fx-text-fill: #27ae60; -fx-font-size: 18px; -fx-font-weight: bold;"
                    text="..."/>
            </VBox>
        </HBox>

        <!-- Stats bar -->
        <HBox spacing="16" style="-fx-padding: 16 30 0 30;">
            <VBox spacing="6" style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 20;" HBox.hgrow="ALWAYS">
                <Label text="ĐANG THAM GIA" style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Label fx:id="lblCountActive" text="0"
                    style="-fx-text-fill: #F5C518; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="6" style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 20;" HBox.hgrow="ALWAYS">
                <Label text="ĐANG DẪN ĐẦU" style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Label fx:id="lblCountLeading" text="0"
                    style="-fx-text-fill: #27ae60; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="6" style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 20;" HBox.hgrow="ALWAYS">
                <Label text="BỊ VƯỢT GIÁ" style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Label fx:id="lblCountOutbid" text="0"
                    style="-fx-text-fill: #e74c3c; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="6" style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 20;" HBox.hgrow="ALWAYS">
                <Label text="ĐÃ THẮNG" style="-fx-text-fill: #666; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Label fx:id="lblCountWon" text="0"
                    style="-fx-text-fill: #3498db; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <!-- Filter bar -->
        <HBox spacing="12" style="-fx-padding: 14 30 0 30;" alignment="CENTER_LEFT">
            <Label text="Lọc:" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
            <ComboBox fx:id="comboFilter"
                style="-fx-background-color: #171717; -fx-text-fill: white; -fx-border-color: #2A2A2A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4 10;"
                prefWidth="200"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#onRefreshClick"
                style="-fx-background-color: #2A2A2A; -fx-text-fill: #F5C518; -fx-border-color: #F5C518; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 7 16; -fx-font-size: 12px;"
                text="🔄 Làm mới"/>
        </HBox>

        <!-- Content: list of bid sessions -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 16 30 20 30;">
            <VBox fx:id="bidsContainer" spacing="12" style="-fx-padding: 4 0 0 0;"/>
        </ScrollPane>

    </VBox>
</StackPane>
