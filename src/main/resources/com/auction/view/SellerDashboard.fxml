<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" styleClass="dark-root" stylesheets="@fileCS/style.css"
    xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.auction.controller.SellerDashboardController"
    prefWidth="1300" prefHeight="900">

    <!-- ====== TOP NAVBAR ====== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
            style="-fx-background-color: #0F0F0F; -fx-border-color: #2A2A2A; -fx-border-width: 0 0 1 0; -fx-padding: 12 25;">
            <Label text="BIDPRECISION" style="-fx-text-fill: #F5C518; -fx-font-size: 20px; -fx-font-weight: 900; -fx-font-family: 'Arial Black';"/>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="1">
                <Label text="TỔNG TÀI SẢN" style="-fx-text-fill: #555; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                <Label fx:id="lblHeaderBalance" text="0 VNĐ" style="-fx-text-fill: #F5C518; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </VBox>
        </HBox>
    </top>

    <!-- ====== LEFT SIDEBAR ====== -->
    <left>
        <VBox style="-fx-background-color: #0a0a0a; -fx-border-color: #1E1E1E; -fx-border-width: 0 1 0 0;" prefWidth="245" spacing="4">
            <!-- Avatar -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                style="-fx-padding: 24 18; -fx-border-color: #1E1E1E; -fx-border-width: 0 0 1 0;">
                <StackPane style="-fx-background-color: #E6B969; -fx-background-radius: 22;" prefWidth="44" prefHeight="44">
                    <Label fx:id="lblAvatarInitials" text="S" style="-fx-text-fill: #000; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label fx:id="lblUsername" text="Seller" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Verified Seller" style="-fx-text-fill: #F5C518; -fx-font-size: 10px;"/>
                </VBox>
            </HBox>

            <!-- Quick action -->
            <Button onAction="#onRequestAppraisalClick" text="📸  Định Giá Sản Phẩm"
                style="-fx-background-color: #E6B969; -fx-text-fill: #000; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10; -fx-font-size: 12px;"
                maxWidth="Infinity">
                <VBox.margin><Insets top="15" left="15" right="15" bottom="5"/></VBox.margin>
            </Button>

            <!-- Menu -->
            <Button text="⊞  Dashboard"
                style="-fx-background-color: #1A1A1A; -fx-text-fill: #F5C518; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 11 20; -fx-font-size: 13px;"
                maxWidth="Infinity"/>
            <Button onAction="#onProfileClick" text="👤  Trang Cá Nhân"
                style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 11 20; -fx-font-size: 13px;"
                maxWidth="Infinity"/>
            <Button onAction="#onViewAllAuctionsClick" text="🌐  Xem Tất Cả Đấu Giá"
                style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 11 20; -fx-font-size: 13px;"
                maxWidth="Infinity"/>
            <Button onAction="#onSettingsClick" text="⚙  Cài Đặt"
                style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 11 20; -fx-font-size: 13px;"
                maxWidth="Infinity"/>

            <Separator style="-fx-background-color: #2A2A2A;"/>
            <Label text="VÍ ĐIỆN TỬ" style="-fx-text-fill: #444; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 20 2 20;"/>
            <Button onAction="#onDepositClick" text="💰  Nạp / Rút Tiền"
                style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 11 20; -fx-font-size: 13px;"
                maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS" />
            <Button onAction="#onLogoutClick" text="⎋  Đăng Xuất"
                style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-border-color: transparent; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 11 20; -fx-font-size: 13px;"
                maxWidth="Infinity">
                <VBox.margin><Insets bottom="15"/></VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ====== CENTER CONTENT ====== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="35" style="-fx-padding: 32 42;">

                <!-- Tiêu đề -->
                <VBox spacing="5">
                    <Label text="Bảng Điều Khiển Người Bán"
                        style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    <Label text="Quản lý kho hàng và theo dõi các phiên đấu giá."
                        style="-fx-text-fill: #666; -fx-font-size: 13px;"/>
                </VBox>

                <!-- ===== Kho hàng ===== -->
                <VBox spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📦  Kho Hàng Của Tôi"
                            style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Chỉ hiện sản phẩm của bạn" style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                    </HBox>
                    <HBox fx:id="inventoryContainer" spacing="18" alignment="TOP_LEFT" minHeight="100"/>
                </VBox>

                <!-- ===== Live Auctions (chỉ xem) ===== -->
                <VBox spacing="14"
                    style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 22;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="🔴  PHIÊN ĐANG DIỄN RA (Chỉ xem)"
                            style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#onViewAllAuctionsClick" text="Xem tất cả →"
                            style="-fx-background-color: transparent; -fx-text-fill: #F5C518; -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Với tư cách Người Bán, bạn không thể đặt giá. Chỉ có thể xem chi tiết."
                        style="-fx-text-fill: #555; -fx-font-size: 11px; -fx-font-style: italic;"/>
                    <HBox fx:id="liveAuctionsList" spacing="16" alignment="TOP_LEFT" minHeight="80"/>
                </VBox>

                <!-- ===== Form Tạo Phiên Đấu Giá Mới ===== -->
                <VBox spacing="20"
                    style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 28;">

                    <Label text="➕  Tạo Phiên Đấu Giá Mới"
                        style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <HBox spacing="25">
                        <!-- Cột trái: Thông tin + ảnh -->
                        <VBox spacing="18" HBox.hgrow="ALWAYS">
                            <!-- Hàng 1: Tên + Giá -->
                            <HBox spacing="18">
                                <VBox spacing="7" HBox.hgrow="ALWAYS">
                                    <Label text="TÊN SẢN PHẨM *"
                                        style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="txtName" promptText="VD: Đồng hồ Rolex Submariner"
                                        styleClass="form-input"/>
                                </VBox>
                                <VBox spacing="7" prefWidth="200">
                                    <Label text="GIÁ KHỞI ĐIỂM (VNĐ) *"
                                        style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="txtStartingPrice" promptText="VD: 50000000"
                                        styleClass="form-input"/>
                                </VBox>
                            </HBox>

                            <!-- Mô tả -->
                            <VBox spacing="7">
                                <Label text="MÔ TẢ SẢN PHẨM"
                                    style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <TextArea fx:id="txtDescription" promptText="Nhập mô tả chi tiết về tình trạng, xuất xứ..."
                                    styleClass="form-input" prefHeight="85" wrapText="true"/>
                            </VBox>

                            <!-- Danh mục -->
                            <VBox spacing="7">
                                <Label text="DANH MỤC *"
                                    style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <ComboBox fx:id="comboCategory" promptText="Chọn danh mục sản phẩm..."
                                    styleClass="form-input" maxWidth="Infinity"/>
                            </VBox>

                            <!-- Thời gian -->
                            <HBox spacing="18">
                                <VBox spacing="7" HBox.hgrow="ALWAYS">
                                    <Label text="NGÀY BẮT ĐẦU"
                                        style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                    <DatePicker fx:id="startDatePicker" styleClass="form-input" maxWidth="Infinity"
                                        promptText="Chọn ngày..."/>
                                </VBox>
                                <VBox spacing="7" prefWidth="130">
                                    <Label text="GIờ BẮT ĐẦU (HH:mm)"
                                        style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="startTimeField" promptText="VD: 14:30"
                                        styleClass="form-input"/>
                                </VBox>
                                <VBox spacing="7" prefWidth="160">
                                    <Label text="THỜI LƯỢNG"
                                        style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                    <ComboBox fx:id="comboDuration" styleClass="form-input" maxWidth="Infinity"
                                        promptText="Chọn thời lượng..."/>
                                </VBox>
                            </HBox>

                            <!-- Form động -->
                            <VBox fx:id="dynamicFormContainer" spacing="14"/>
                        </VBox>

                        <!-- Cột phải: Upload ảnh -->
                        <VBox spacing="12" prefWidth="260">
                            <Label text="ẢNH SẢN PHẨM"
                                style="-fx-text-fill: #A0A0A0; -fx-font-size: 10px; -fx-font-weight: bold;"/>

                            <!-- Vùng preview ảnh -->
                            <StackPane fx:id="imagePreviewBox" prefWidth="260" prefHeight="180"
                                style="-fx-background-color: #1A1A1A; -fx-border-color: #333; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-style: dashed;">
                                <ImageView fx:id="imgPreview" fitWidth="260" fitHeight="180"
                                    preserveRatio="true" visible="false"/>
                                <VBox alignment="CENTER" spacing="8" fx:id="lblImageHintBox">
                                    <Label fx:id="lblImageHint" text="📷" style="-fx-font-size: 40px;"/>
                                    <Label text="Nhấn để chọn ảnh" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                                    <Label text="PNG, JPG, GIF (max 5MB)" style="-fx-text-fill: #444; -fx-font-size: 10px;"/>
                                </VBox>
                            </StackPane>

                            <!-- Nút chọn / xóa ảnh -->
                            <HBox spacing="10">
                                <Button onAction="#onChooseImageClick" text="📁  Chọn Ảnh"
                                    style="-fx-background-color: #2A2A2A; -fx-text-fill: #F5C518; -fx-border-color: #F5C518; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 8 15; -fx-font-size: 12px;"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button onAction="#onRemoveImageClick" text="🗑"
                                    style="-fx-background-color: rgba(231,76,60,0.2); -fx-text-fill: #e74c3c; -fx-border-color: #e74c3c; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 8 12;"/>
                            </HBox>

                            <!-- Gợi ý ảnh đẹp -->
                            <Label text="💡 Ảnh rõ nét, nền trắng/đen tăng độ chuyên nghiệp"
                                style="-fx-text-fill: #444; -fx-font-size: 10px; -fx-font-style: italic;" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <!-- Nút hành động -->
                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button onAction="#onClearFormClick" text="Xóa Form" styleClass="btn-outline"
                            style="-fx-padding: 10 22;"/>
                        <Button onAction="#onPublishClick" text="🚀  Đăng Bán Ngay" styleClass="btn-gold"
                            style="-fx-padding: 10 28; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>