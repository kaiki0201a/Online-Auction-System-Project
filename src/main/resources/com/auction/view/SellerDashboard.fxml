<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" styleClass="dark-root" stylesheets="@fileCS/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.SellerDashboardController"
            prefWidth="1300" prefHeight="900"
            style="-fx-background-color: #1A1A1D;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="25"
              style="-fx-background-color: #111113; -fx-border-color: #2A2A2A; -fx-border-width: 0 0 1 0; -fx-padding: 15 30;">
            <Label text="BIDPRECISION" style="-fx-text-fill: #F5C71A; -fx-font-size: 24px; -fx-font-weight: 900; -fx-font-family: 'Arial Black';"/>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Label fx:id="lblHeaderBalance" text="0 VNĐ" style="-fx-text-fill: #F5C71A; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Label text="🔔" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"/>
                <Label text="💳" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #111113; -fx-border-color: #2A2A2A; -fx-border-width: 0 1 0 0;" prefWidth="250" spacing="8">
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-padding: 25 20; -fx-cursor: hand;"
                  onMouseClicked="#onAvatarClick">
                <StackPane style="-fx-background-color: #1A1A1D; -fx-border-color: #555; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="50" prefHeight="50">
                    <Label fx:id="lblAvatarInitials" text="S" style="-fx-text-fill: #F5C71A; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="3">
                    <Label fx:id="lblUsername" text="Elite Collector" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <Label text="Verified Member" style="-fx-text-fill: #F5C71A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Button onAction="#onRequestAppraisalClick" text="Định giá sản phẩm"
                    style="-fx-background-color: #F5C71A; -fx-text-fill: #111113; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10; -fx-font-size: 13px;"
                    maxWidth="Infinity">
                <VBox.margin><Insets left="20" right="20" bottom="15"/></VBox.margin>
            </Button>

            <Button onAction="#onDashboardClick" text="⊞   Dashboard"
                    style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-border-color: #F5C71A; -fx-border-width: 0 0 0 4; -fx-cursor: hand;"
                    maxWidth="Infinity"/>
            <Button onAction="#onProfileClick" text="👤   Trang Cá Nhân"
                    style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    maxWidth="Infinity"/>

            <Button onAction="#onViewAllAuctionsClick" text="👁   Xem Tất cả đấu giá"
                    style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    maxWidth="Infinity"/>

            <Button onAction="#onDepositClick" text="🛍   Nạp / Rút Tiền"
                    style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#onSettingsClick" text="⚙   Settings"
                    style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    maxWidth="Infinity"/>
            <Button onAction="#onLogoutClick" text="⎋   Đăng Xuất"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 13px;"
                    maxWidth="Infinity">
                <VBox.margin><Insets bottom="15"/></VBox.margin>
            </Button>
        </VBox>
    </left>


    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #1A1A1D; -fx-control-inner-background: #1A1A1D; -fx-background: #1A1A1D; -fx-border-color: transparent;">
            <VBox spacing="40" style="-fx-padding: 40 50; -fx-background-color: #1A1A1D;">

                <VBox spacing="8">
                    <Label text="Bảng Điều Khiển Người Bán"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    <Label text="Quản lý kho hàng và tạo phiên đấu giá mới."
                           style="-fx-text-fill: #888888; -fx-font-size: 14px;"/>
                </VBox>

                <VBox spacing="15">
                    <HBox alignment="CENTER_LEFT" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
                        <Label text="Quản Lý Kho Hàng"
                               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="15">
                            <Label text="≡ Lọc" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-cursor: hand;"/>
                            <Label text="⇅ Sắp xếp" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-cursor: hand;"/>
                        </HBox>
                    </HBox>
                    <HBox fx:id="inventoryContainer" spacing="20" alignment="TOP_LEFT" minHeight="120"/>
                </VBox>

                <VBox spacing="14"
                      style="-fx-background-color: #111113; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 25;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="🔴  PHIÊN ĐANG DIỄN RA"
                               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#onViewAllAuctionsClick" text="Xem tất cả →"
                                style="-fx-background-color: transparent; -fx-text-fill: #F5C71A; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox fx:id="liveAuctionsList" spacing="20" alignment="TOP_LEFT" minHeight="100"/>
                </VBox>

                <VBox spacing="14"
                      style="-fx-background-color: #111113; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 25;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="💰  LỊCH SỬ NHẬN TIỀN"
                               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalEarned" text="Tổng nhận: 0 VNĐ"
                               style="-fx-text-fill: #F5C71A; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </HBox>
                    <TableView fx:id="tablePaymentHistory" prefHeight="200"
                               style="-fx-background-color: #1A1A1D; -fx-border-color: #2A2A2A; -fx-border-radius: 4;">
                        <columns>
                            <TableColumn fx:id="colPayItem" text="Sản Phẩm" prefWidth="260"/>
                            <TableColumn fx:id="colPayDate" text="Thời Gian Nhận" prefWidth="160"/>
                            <TableColumn fx:id="colPayAmount" text="Số Tiền Nhận" prefWidth="160"/>
                            <TableColumn fx:id="colPayStatus" text="Trạng Thái" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="Chưa có phiên đấu giá nào." style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <VBox spacing="25"
                      style="-fx-background-color: #111113; -fx-border-color: #333333; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 35;">

                    <VBox spacing="8" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 15 0;">
                        <Label text="Tạo Phiên Đấu Giá Mới"
                               style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <Label text="Nhập thông tin chi tiết để liệt kê mặt hàng của bạn."
                               style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                    </VBox>

                    <HBox spacing="30">
                        <VBox spacing="20" HBox.hgrow="ALWAYS">
                            <HBox spacing="20">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="TÊN MẶT HÀNG" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="txtName" promptText="Ví dụ: 1969 Ford Mustang Mach 1"
                                               style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;"/>
                                </VBox>
                                <VBox spacing="8" prefWidth="250">
                                    <Label text="DANH MỤC" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <ComboBox fx:id="comboCategory" promptText="Chọn Danh Mục..."
                                              style="-fx-background-color: #1A1A1D; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4;" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <VBox fx:id="dynamicFormContainer" spacing="15"
                                  style="-fx-border-color: #333; -fx-border-style: dashed; -fx-border-radius: 4; -fx-padding: 15;">
                            </VBox>

                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="8" prefWidth="180">
                                    <Label text="GIÁ KHỞI ĐIỂM (VNĐ)" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="txtStartingPrice" promptText="0 VNĐ"
                                               style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;"/>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <VBox spacing="8">
                                    <Label text="NGÀY BẮT ĐẦU" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <DatePicker fx:id="datePickerStart" promptText="mm/dd/yyyy"
                                                style="-fx-background-color: #1A1A1D; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4;"/>
                                </VBox>
                                <VBox spacing="8">
                                    <Label text="GIỜ BẮT ĐẦU" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="txtTimeStart" promptText="--:-- --"
                                               style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="8">
                                    <Label text="NGÀY KẾT THÚC" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <DatePicker fx:id="datePickerEnd" promptText="mm/dd/yyyy"
                                                style="-fx-background-color: #1A1A1D; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4;"/>
                                </VBox>
                                <VBox spacing="8">
                                    <Label text="GIỜ KẾT THÚC" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    <TextField fx:id="txtTimeEnd" promptText="--:-- --"
                                               style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="8">
                                <Label text="MÔ TẢ SẢN PHẨM" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <TextArea fx:id="txtDescription" promptText="Nhập mô tả chi tiết..."
                                          style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4;" prefHeight="60" wrapText="true"/>
                            </VBox>
                        </VBox>

                        <VBox spacing="12" prefWidth="320">
                            <Label text="HÌNH ẢNH ĐỘ PHÂN GIẢI CAO" style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                            <StackPane fx:id="imagePreviewBox" prefHeight="220"
                                       style="-fx-background-color: #1A1A1D; -fx-border-color: #333333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-border-style: dashed;">
                                <ImageView fx:id="imgPreview" fitWidth="300" fitHeight="200" preserveRatio="true" visible="false"/>

                                <VBox alignment="CENTER" spacing="10" fx:id="lblImageHintBox">
                                    <Label fx:id="lblImageHint" text="☁" style="-fx-text-fill: white; -fx-font-size: 32px;"/>
                                    <Label text="Kéo và thả hình ảnh vào đây" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                                    <Label text="Hỗ trợ JPG, PNG chất lượng cao. Tối đa 20MB." style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
                                    <Button onAction="#onChooseImageClick" text="Duyệt File"
                                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #F5C71A; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 8 20;">
                                        <VBox.margin><Insets top="10"/></VBox.margin>
                                    </Button>
                                </VBox>
                            </StackPane>

                            <Button onAction="#onRemoveImageClick" text="Xóa ảnh hiện tại"
                                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand; -fx-padding: 5 0;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0; -fx-border-color: #333333; -fx-border-width: 1 0 0 0;">
                        <Button onAction="#onClearFormClick" text="Lưu Bản Nháp"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 4; -fx-padding: 10 25; -fx-cursor: hand;"/>
                        <Button onAction="#onPublishClick" text="Tạo Phiên Đấu Giá"
                                style="-fx-background-color: #FFE066; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10 25; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>