<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="900" prefWidth="1300"
            style="-fx-background-color: #0A0B0D;"
            styleClass="dark-root"
            stylesheets="@fileCS/style.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.SellerDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="25" styleClass="navbar-dark" prefHeight="72">
            <Label styleClass="brand-logo" text="BIDPRECISION">
                <padding>
                   <Insets bottom="10.0" top="10.0" />
                </padding>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Label fx:id="lblHeaderBalance" styleClass="label-gold" style="-fx-font-size: 16px;" text="0 VNĐ" />
                <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="🔔" />
                <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="💳" />
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="250" spacing="8" styleClass="sidebar-dark">
            <HBox alignment="CENTER_LEFT" onMouseClicked="#onAvatarClick" spacing="15"
                  style="-fx-padding: 25 20; -fx-cursor: hand;
                         -fx-border-color: #2D3138; -fx-border-width: 0 0 1 0;">
                <StackPane prefHeight="50" prefWidth="50"
                           style="-fx-background-color: #0A0B0D;
                                  -fx-border-color: #2D3138;
                                  -fx-border-radius: 10;
                                  -fx-background-radius: 10;">
                    <Label fx:id="lblAvatarInitials" styleClass="label-gold" style="-fx-font-size: 20px;" text="S" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="3">
                    <Label fx:id="lblUsername" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Elite Collector" />
                    <Label styleClass="label-gold" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Seller" />
                </VBox>
            </HBox>

            <Button maxWidth="Infinity" onAction="#onRequestAppraisalClick"
                    styleClass="btn-gold-luxury"
                    style="-fx-padding: 10; -fx-font-size: 13px;"
                    text="Định giá sản phẩm">
                <VBox.margin><Insets bottom="15" left="20" right="20" /></VBox.margin>
            </Button>

            <Button maxWidth="Infinity" onAction="#onDashboardClick"
                    style="-fx-background-color: #0A0B0D;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20;
                           -fx-border-color: #E8D06E;
                           -fx-border-width: 0 0 0 4;
                           -fx-cursor: hand;"
                    text="⊞   Dashboard" />
            <Button maxWidth="Infinity" onAction="#onProfileClick"
                    styleClass="menu-btn"
                    text="👤   Trang Cá Nhân" />
            <Button maxWidth="Infinity" onAction="#onViewAllAuctionsClick"
                    styleClass="menu-btn"
                    text="👁   Xem Tất cả đấu giá" />
            <Button maxWidth="Infinity" onAction="#onDepositClick"
                    styleClass="menu-btn"
                    text="🛍   Nạp / Rút Tiền" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#onSettingsClick"
                    styleClass="menu-btn"
                    text="⚙   Settings" />
            <Button maxWidth="Infinity" onAction="#onLogoutClick"
                    styleClass="btn-logout-danger"
                    style="-fx-alignment: CENTER_LEFT; -fx-padding: 12 20;"
                    text="⎋   Đăng Xuất">
                <VBox.margin><Insets bottom="15" /></VBox.margin>
            </Button>
        </VBox>
    </left>


    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #0A0B0D; -fx-control-inner-background: #0A0B0D; -fx-background: #0A0B0D; -fx-border-color: transparent;">
            <VBox spacing="40" style="-fx-padding: 40 50; -fx-background-color: #0A0B0D;">

                <VBox spacing="8">
                    <Label styleClass="label-page-title" style="-fx-font-size: 28px;" text="Bảng Điều Khiển Người Bán" />
                    <Label styleClass="label-sub" text="Quản lý kho hàng và tạo phiên đấu giá mới." />
                </VBox>

                <VBox spacing="15">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-border-color: #2D3138; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
                        <Label styleClass="label-section-title" style="-fx-font-size: 20px;" text="Quản Lý Kho Hàng" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="15">
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-cursor: hand;" text="≡ Lọc" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-cursor: hand;" text="⇅ Sắp xếp" />
                        </HBox>
                    </HBox>
                    <HBox fx:id="inventoryContainer" alignment="TOP_LEFT" minHeight="120" spacing="20" />
                </VBox>

                <!-- Phiên đang diễn ra -->
                <VBox spacing="14" styleClass="card-dark">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="label-section-title" text="🔴  PHIÊN ĐANG DIỄN RA" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#onViewAllAuctionsClick" styleClass="btn-text-gold" text="Xem tất cả →" />
                    </HBox>
                    <HBox fx:id="liveAuctionsList" alignment="TOP_LEFT" minHeight="100" spacing="20" />
                </VBox>

                <!-- Lịch sử nhận tiền -->
                <VBox spacing="14" styleClass="card-dark">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="label-section-title" text="💰  LỊCH SỬ NHẬN TIỀN" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalEarned" styleClass="label-gold" style="-fx-font-size: 14px;" text="Tổng nhận: 0 VNĐ" />
                    </HBox>
                    <TableView fx:id="tablePaymentHistory" prefHeight="200"
                               style="-fx-background-color: transparent; -fx-border-color: #2D3138; -fx-border-radius: 4;">
                        <columns>
                            <TableColumn fx:id="colPayItem" prefWidth="260" text="Sản Phẩm" />
                            <TableColumn fx:id="colPayDate" prefWidth="160" text="Thời Gian Nhận" />
                            <TableColumn fx:id="colPayAmount" prefWidth="220.0" text="Số Tiền Nhận" />
                            <TableColumn fx:id="colPayStatus" prefWidth="239.0" text="Trạng Thái" />
                        </columns>
                        <placeholder>
                            <Label styleClass="label-sub" text="Chưa có phiên đấu giá nào." />
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Form tạo phiên đấu giá mới -->
                <VBox spacing="25" styleClass="card-dark">

                    <VBox spacing="8"
                          style="-fx-border-color: #2D3138; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 15 0;">
                        <Label styleClass="label-page-title" style="-fx-font-size: 24px;" text="Tạo Phiên Đấu Giá Mới" />
                        <Label styleClass="label-sub" text="Nhập thông tin chi tiết để liệt kê mặt hàng của bạn." />
                    </VBox>

                    <HBox spacing="30">
                        <VBox spacing="20" HBox.hgrow="ALWAYS">
                            <HBox spacing="20">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label styleClass="label-caption" text="TÊN MẶT HÀNG" />
                                    <TextField fx:id="txtName" promptText="Ví dụ: 1969 Ford Mustang Mach 1"
                                               style="-fx-background-color: #0A0B0D; -fx-text-fill: white; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>
                                <VBox prefWidth="250" spacing="8">
                                    <Label styleClass="label-caption" text="DANH MỤC" />
                                    <ComboBox fx:id="comboCategory" maxWidth="Infinity" promptText="Chọn Danh Mục..."
                                              style="-fx-background-color: #0A0B0D; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4;" />
                                </VBox>
                            </HBox>

                            <VBox fx:id="dynamicFormContainer" spacing="15"
                                  style="-fx-border-color: #2D3138; -fx-border-style: dashed; -fx-border-radius: 4; -fx-padding: 15;">
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <VBox prefWidth="180" spacing="8">
                                    <Label styleClass="label-caption" text="GIÁ KHỞI ĐIỂM (VNĐ)" />
                                    <TextField fx:id="txtStartingPrice" promptText="0 VNĐ"
                                               style="-fx-background-color: #0A0B0D; -fx-text-fill: white; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <VBox spacing="8">
                                    <Label styleClass="label-caption" text="NGÀY BẮT ĐẦU" />
                                    <DatePicker fx:id="datePickerStart" promptText="mm/dd/yyyy"
                                                style="-fx-background-color: #0A0B0D; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4;" />
                                </VBox>
                                <VBox spacing="8">
                                    <Label styleClass="label-caption" text="GIỜ BẮT ĐẦU" />
                                    <TextField fx:id="txtTimeStart" promptText="--:-- --"
                                               style="-fx-background-color: #0A0B0D; -fx-text-fill: white; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <VBox spacing="8">
                                    <Label styleClass="label-caption" text="NGÀY KẾT THÚC" />
                                    <DatePicker fx:id="datePickerEnd" promptText="mm/dd/yyyy"
                                                style="-fx-background-color: #0A0B0D; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4;" />
                                </VBox>
                                <VBox spacing="8">
                                    <Label styleClass="label-caption" text="GIỜ KẾT THÚC" />
                                    <TextField fx:id="txtTimeEnd" promptText="--:-- --"
                                               style="-fx-background-color: #0A0B0D; -fx-text-fill: white; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>
                            </HBox>

                            <VBox spacing="8">
                                <Label styleClass="label-caption" text="MÔ TẢ SẢN PHẨM" />
                                <TextArea fx:id="txtDescription" prefHeight="60" promptText="Nhập mô tả chi tiết..."
                                          style="-fx-background-color: #0A0B0D; -fx-text-fill: white; -fx-border-color: #2D3138; -fx-border-radius: 4;"
                                          wrapText="true" />
                            </VBox>
                        </VBox>

                        <VBox prefWidth="320" spacing="12">
                            <Label styleClass="label-caption" text="HÌNH ẢNH ĐỘ PHÂN GIẢI CAO" />

                            <StackPane fx:id="imagePreviewBox" prefHeight="220"
                                       style="-fx-background-color: #0A0B0D; -fx-border-color: #2D3138; -fx-border-radius: 4; -fx-background-radius: 4; -fx-border-style: dashed;">
                                <ImageView fx:id="imgPreview" fitHeight="200" fitWidth="300" preserveRatio="true" visible="false" />

                                <VBox fx:id="lblImageHintBox" alignment="CENTER" spacing="10">
                                    <Label fx:id="lblImageHint" style="-fx-text-fill: white; -fx-font-size: 32px;" text="☁" />
                                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Kéo và thả hình ảnh vào đây" />
                                    <Label styleClass="label-sub" style="-fx-font-size: 11px;" text="Hỗ trợ JPG, PNG chất lượng cao. Tối đa 20MB." />
                                    <Button onAction="#onChooseImageClick" styleClass="btn-outline-gold" style="-fx-padding: 8 20;" text="Duyệt File">
                                        <VBox.margin><Insets top="10" /></VBox.margin>
                                    </Button>
                                </VBox>
                            </StackPane>

                            <Button onAction="#onRemoveImageClick"
                                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand; -fx-padding: 5 0;"
                                    text="Xóa ảnh hiện tại" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="15"
                          style="-fx-padding: 20 0 0 0; -fx-border-color: #2D3138; -fx-border-width: 1 0 0 0;">
                        <Button onAction="#onClearFormClick" styleClass="btn-outline" style="-fx-padding: 10 25;" text="Lưu Bản Nháp" />
                        <Button onAction="#onPublishClick" styleClass="btn-gold-luxury" style="-fx-padding: 10 25;" text="Tạo Phiên Đấu Giá" />
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
