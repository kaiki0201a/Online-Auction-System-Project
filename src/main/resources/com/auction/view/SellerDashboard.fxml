<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="900" prefWidth="1300" style="-fx-background-color: #1A1A1D;" styleClass="dark-root" stylesheets="@fileCS/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.SellerDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="25" style="-fx-background-color: #111113; -fx-border-color: #2A2A2A; -fx-border-width: 0 0 1 0; -fx-padding: 15 30;">
            <Label style="-fx-text-fill: #E7D29B; -fx-font-size: 24px; -fx-font-weight: 900; -fx-font-family: 'Arial Black';" text="BIDPRECISION">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Label>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Label fx:id="lblHeaderBalance" style="-fx-text-fill: #F5C71A; -fx-font-weight: bold; -fx-font-size: 16px;" text="0 VNĐ" />
                <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="🔔" />
                <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="💳" />
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="250" spacing="8" style="-fx-background-color: #111113; -fx-border-color: #2A2A2A; -fx-border-width: 0 1 0 0;">
            <HBox alignment="CENTER_LEFT" onMouseClicked="#onAvatarClick" spacing="15" style="-fx-padding: 25 20; -fx-cursor: hand;">
                <StackPane prefHeight="50" prefWidth="50" style="-fx-background-color: #1A1A1D; -fx-border-color: #555; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Label fx:id="lblAvatarInitials" style="-fx-text-fill: #F5C71A; -fx-font-size: 20px; -fx-font-weight: bold;" text="S" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="3">
                    <Label fx:id="lblUsername" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Elite Collector" />
                    <Label style="-fx-text-fill: #F5C71A; -fx-font-size: 11px; -fx-font-weight: bold;" text="Seller" />
                </VBox>
            </HBox>

            <Button maxWidth="Infinity" onAction="#onRequestAppraisalClick" style="-fx-background-color: #F5C71A; -fx-text-fill: #111113; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10; -fx-font-size: 13px;" text="Định giá sản phẩm">
                <VBox.margin><Insets bottom="15" left="20" right="20" /></VBox.margin>
            </Button>

            <Button maxWidth="Infinity" onAction="#onDashboardClick" style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-border-color: #F5C71A; -fx-border-width: 0 0 0 4; -fx-cursor: hand;" text="⊞   Dashboard" />
            <Button maxWidth="Infinity" onAction="#onProfileClick" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;" text="👤   Trang Cá Nhân" />

            <Button maxWidth="Infinity" onAction="#onViewAllAuctionsClick" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;" text="👁   Xem Tất cả đấu giá" />

            <Button maxWidth="Infinity" onAction="#onDepositClick" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;" text="🛍   Nạp / Rút Tiền" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#onSettingsClick" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;" text="⚙   Settings" />
            <Button maxWidth="Infinity" onAction="#onLogoutClick" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 13px;" text="⎋   Đăng Xuất">
                <VBox.margin><Insets bottom="15" /></VBox.margin>
            </Button>
        </VBox>
    </left>


    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #1A1A1D; -fx-control-inner-background: #1A1A1D; -fx-background: #1A1A1D; -fx-border-color: transparent;">
            <VBox spacing="40" style="-fx-padding: 40 50; -fx-background-color: #1A1A1D;">

                <VBox spacing="8">
                    <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Bảng Điều Khiển Người Bán" />
                    <Label style="-fx-text-fill: #888888; -fx-font-size: 14px;" text="Quản lý kho hàng và tạo phiên đấu giá mới." />
                </VBox>

                <VBox spacing="15">
                    <HBox alignment="CENTER_LEFT" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Quản Lý Kho Hàng" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="15">
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-cursor: hand;" text="≡ Lọc" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-cursor: hand;" text="⇅ Sắp xếp" />
                        </HBox>
                    </HBox>
                    <HBox fx:id="inventoryContainer" alignment="TOP_LEFT" minHeight="120" spacing="20" />
                </VBox>

                <VBox spacing="14" style="-fx-background-color: #111113; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 25;">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="🔴  PHIÊN ĐANG DIỄN RA" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#onViewAllAuctionsClick" style="-fx-background-color: transparent; -fx-text-fill: #F5C71A; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;" text="Xem tất cả →" />
                    </HBox>
                    <HBox fx:id="liveAuctionsList" alignment="TOP_LEFT" minHeight="100" spacing="20" />
                </VBox>

                <VBox spacing="14" style="-fx-background-color: #111113; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 25;">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="💰  LỊCH SỬ NHẬN TIỀN" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalEarned" style="-fx-text-fill: #F5C71A; -fx-font-size: 14px; -fx-font-weight: bold;" text="Tổng nhận: 0 VNĐ" />
                    </HBox>
                    <TableView fx:id="tablePaymentHistory" prefHeight="200" style="-fx-background-color: #1A1A1D; -fx-border-color: #2A2A2A; -fx-border-radius: 4;">
                        <columns>
                            <TableColumn fx:id="colPayItem" prefWidth="260" text="Sản Phẩm" />
                            <TableColumn fx:id="colPayDate" prefWidth="160" text="Thời Gian Nhận" />
                            <TableColumn fx:id="colPayAmount" prefWidth="220.0" text="Số Tiền Nhận" />
                            <TableColumn fx:id="colPayStatus" prefWidth="239.0" text="Trạng Thái" />
                        </columns>
                        <placeholder>
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Chưa có phiên đấu giá nào." />
                        </placeholder>
                    </TableView>
                </VBox>

                <VBox spacing="25" style="-fx-background-color: #111113; -fx-border-color: #333333; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 35;">

                    <VBox spacing="8" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 15 0;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Tạo Phiên Đấu Giá Mới" />
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Nhập thông tin chi tiết để liệt kê mặt hàng của bạn." />
                    </VBox>

                    <HBox spacing="30">
                        <VBox spacing="20" HBox.hgrow="ALWAYS">
                            <HBox spacing="20">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="TÊN MẶT HÀNG" />
                                    <TextField fx:id="txtName" promptText="Ví dụ: 1969 Ford Mustang Mach 1" style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>
                                <VBox prefWidth="250" spacing="8">
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="DANH MỤC" />
                                    <ComboBox fx:id="comboCategory" maxWidth="Infinity" promptText="Chọn Danh Mục..." style="-fx-background-color: #1A1A1D; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4;" />
                                </VBox>
                            </HBox>

                            <VBox fx:id="dynamicFormContainer" spacing="15" style="-fx-border-color: #333; -fx-border-style: dashed; -fx-border-radius: 4; -fx-padding: 15;">
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <VBox prefWidth="180" spacing="8">
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="GIÁ KHỞI ĐIỂM (VNĐ)" />
                                    <TextField fx:id="txtStartingPrice" promptText="0 VNĐ" style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="NGÀY BẮT ĐẦU" />
                                    <DatePicker fx:id="datePickerStart" promptText="mm/dd/yyyy" style="-fx-background-color: #1A1A1D; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4;" />
                                </VBox>
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="GIỜ BẮT ĐẦU" />
                                    <TextField fx:id="txtTimeStart" promptText="--:-- --" style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="NGÀY KẾT THÚC" />
                                    <DatePicker fx:id="datePickerEnd" promptText="mm/dd/yyyy" style="-fx-background-color: #1A1A1D; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4;" />
                                </VBox>
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="GIỜ KẾT THÚC" />
                                    <TextField fx:id="txtTimeEnd" promptText="--:-- --" style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" />
                                </VBox>
                            </HBox>

                            <VBox spacing="8">
                                <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="MÔ TẢ SẢN PHẨM" />
                                <TextArea fx:id="txtDescription" prefHeight="60" promptText="Nhập mô tả chi tiết..." style="-fx-background-color: #1A1A1D; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 4;" wrapText="true" />
                            </VBox>
                        </VBox>

                        <VBox prefWidth="320" spacing="12">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-weight: bold;" text="HÌNH ẢNH ĐỘ PHÂN GIẢI CAO" />

                            <StackPane fx:id="imagePreviewBox" prefHeight="220" style="-fx-background-color: #1A1A1D; -fx-border-color: #333333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-border-style: dashed;">
                                <ImageView fx:id="imgPreview" fitHeight="200" fitWidth="300" preserveRatio="true" visible="false" />

                                <VBox fx:id="lblImageHintBox" alignment="CENTER" spacing="10">
                                    <Label fx:id="lblImageHint" style="-fx-text-fill: white; -fx-font-size: 32px;" text="☁" />
                                    <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Kéo và thả hình ảnh vào đây" />
                                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;" text="Hỗ trợ JPG, PNG chất lượng cao. Tối đa 20MB." />
                                    <Button onAction="#onChooseImageClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #F5C71A; -fx-border-radius: 4; -fx-cursor: hand; -fx-padding: 8 20;" text="Duyệt File">
                                        <VBox.margin><Insets top="10" /></VBox.margin>
                                    </Button>
                                </VBox>
                            </StackPane>

                            <Button onAction="#onRemoveImageClick" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand; -fx-padding: 5 0;" text="Xóa ảnh hiện tại" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 20 0 0 0; -fx-border-color: #333333; -fx-border-width: 1 0 0 0;">
                        <Button onAction="#onClearFormClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 4; -fx-padding: 10 25; -fx-cursor: hand;" text="Lưu Bản Nháp" />
                        <Button onAction="#onPublishClick" style="-fx-background-color: #FFE066; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10 25; -fx-cursor: hand;" text="Tạo Phiên Đấu Giá" />
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
