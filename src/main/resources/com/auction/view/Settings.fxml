<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" stylesheets="@fileCS/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.SettingsController">

    <VBox prefWidth="600.0" prefHeight="500.0" style="-fx-background-color: #0d0d0d;" alignment="CENTER">
        <padding><Insets bottom="0" left="0" right="0" top="0" /></padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #0F0F0F; -fx-border-color: #2A2A2A; -fx-border-width: 0 0 1 0; -fx-padding: 15 30;">
            <Button onAction="#onBackClick" style="-fx-background-color: transparent; -fx-text-fill: #F5C518; -fx-font-size: 16px; -fx-cursor: hand;" text="← Quay Lại" />
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Cài Đặt Tài Khoản" />
        </HBox>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox spacing="25.0" style="-fx-padding: 30 40;">

                <!-- Thông tin tài khoản -->
                <VBox spacing="15.0" style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20;">
                    <Label style="-fx-text-fill: #F5C518; -fx-font-size: 14px; -fx-font-weight: bold;" text="📋 THÔNG TIN TÀI KHOẢN" />

                    <HBox spacing="40">
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #666; -fx-font-size: 11px;" text="TÊN ĐĂNG NHẬP" />
                            <Label fx:id="lblUsername" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="..." />
                        </VBox>
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #666; -fx-font-size: 11px;" text="LOẠI TÀI KHOẢN" />
                            <Label fx:id="lblRole" style="-fx-text-fill: #F5C518; -fx-font-size: 16px; -fx-font-weight: bold;" text="..." />
                        </VBox>
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #666; -fx-font-size: 11px;" text="SỐ DƯ" />
                            <Label fx:id="lblBalance" style="-fx-text-fill: #27ae60; -fx-font-size: 16px; -fx-font-weight: bold;" text="..." />
                        </VBox>
                    </HBox>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: #666; -fx-font-size: 11px;" text="EMAIL HIỆN TẠI:" />
                        <Label fx:id="lblEmail" style="-fx-text-fill: #A0A0A0;" text="..." />
                    </HBox>
                </VBox>

                <!-- Đổi Email -->
                <VBox spacing="15.0" style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20;">
                    <Label style="-fx-text-fill: #F5C518; -fx-font-size: 14px; -fx-font-weight: bold;" text="✉ ĐỔI EMAIL" />

                    <VBox spacing="8.0">
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 11px; -fx-font-weight: bold;" text="EMAIL MỚI" />
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 15;">
                            <Label style="-fx-text-fill: #F5C518;" text="✉ " />
                            <TextField fx:id="txtNewEmail" promptText="Nhập email mới"
                                style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-padding: 11 10;"
                                HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <Button maxWidth="Infinity" onAction="#onUpdateEmailClick"
                        style="-fx-background-color: #2A2A2A; -fx-text-fill: #F5C518; -fx-font-weight: bold; -fx-border-color: #F5C518; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10;"
                        text="Cập Nhật Email" />
                </VBox>

                <!-- Đổi Mật Khẩu -->
                <VBox spacing="15.0" style="-fx-background-color: #171717; -fx-border-color: #2A2A2A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20;">
                    <Label style="-fx-text-fill: #F5C518; -fx-font-size: 14px; -fx-font-weight: bold;" text="🔒 ĐỔI MẬT KHẨU" />

                    <VBox spacing="10">
                        <VBox spacing="6.0">
                            <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 11px; -fx-font-weight: bold;" text="MẬT KHẨU HIỆN TẠI" />
                            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 15;">
                                <Label style="-fx-text-fill: #F5C518;" text="🔑 " />
                                <PasswordField fx:id="txtCurrentPassword" promptText="Mật khẩu hiện tại"
                                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-padding: 11 10;"
                                    HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                        <VBox spacing="6.0">
                            <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 11px; -fx-font-weight: bold;" text="MẬT KHẨU MỚI (ít nhất 6 ký tự)" />
                            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 15;">
                                <Label style="-fx-text-fill: #F5C518;" text="🔒 " />
                                <PasswordField fx:id="txtNewPassword" promptText="Mật khẩu mới"
                                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-padding: 11 10;"
                                    HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                        <VBox spacing="6.0">
                            <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 11px; -fx-font-weight: bold;" text="XÁC NHẬN MẬT KHẨU MỚI" />
                            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 15;">
                                <Label style="-fx-text-fill: #F5C518;" text="🔒 " />
                                <PasswordField fx:id="txtConfirmNewPassword" promptText="Nhập lại mật khẩu mới"
                                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white; -fx-prompt-text-fill: #555; -fx-padding: 11 10;"
                                    HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                    </VBox>
                    <Button maxWidth="Infinity" onAction="#onChangePasswordClick"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 10;"
                        text="Đổi Mật Khẩu" />
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
