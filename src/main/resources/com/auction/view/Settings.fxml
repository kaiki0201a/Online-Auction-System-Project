<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" styleClass="dark-root" stylesheets="@fileCS/style.css"
    xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.auction.controller.SettingsController">

    <VBox prefWidth="600.0" prefHeight="530.0" style="-fx-background-color: #0A0B0D;" alignment="TOP_CENTER">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="navbar-dark" prefHeight="58">
            <Button onAction="#onBackClick" styleClass="btn-back"
                    style="-fx-border-color: #2D3138; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 14;"
                    text="← Quay Lại"/>
            <Label text="⚙" style="-fx-text-fill: #E8D06E; -fx-font-size: 20px;"/>
            <Label styleClass="label-section-title" text="Cài Đặt Tài Khoản"/>
        </HBox>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox spacing="18.0" style="-fx-padding: 24 36;">

                <!-- Avatar + Thông tin tài khoản -->
                <VBox spacing="14.0" styleClass="card-dark">
                    <HBox spacing="18" alignment="CENTER_LEFT">
                        <!-- Avatar circle -->
                        <StackPane styleClass="avatar-circle"
                            prefWidth="68" prefHeight="68">
                            <Label fx:id="lblAvatarInitials" text="?"
                                styleClass="avatar-initials" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="lblUsername"
                                styleClass="label-section-title" style="-fx-font-size: 20px;" text="..."/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label fx:id="lblRole"
                                    styleClass="label-gold"
                                    style="-fx-font-size: 12px; -fx-background-color: rgba(232,208,110,0.1); -fx-padding: 3 10; -fx-background-radius: 12;"
                                    text="..."/>
                                <Label fx:id="lblEmail"
                                    styleClass="label-caption" style="-fx-font-size: 12px;" text="..."/>
                            </HBox>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox spacing="4" alignment="CENTER_RIGHT">
                            <Label text="SỐ DƯ VÍ" styleClass="label-caption"/>
                            <Label fx:id="lblBalance"
                                style="-fx-text-fill: #27ae60; -fx-font-size: 18px; -fx-font-weight: bold;" text="..."/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Thông Tin Hồ Sơ -->
                <VBox spacing="14.0" styleClass="card-dark">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="👤" style="-fx-font-size: 18px;"/>
                        <Label styleClass="label-section-title" text="THÔNG TIN HỒ SƠ"/>
                    </HBox>
                    <Label text="Tên đăng nhập không thể thay đổi sau khi tạo tài khoản."
                        styleClass="label-caption" style="-fx-font-size: 11px;" wrapText="true"/>

                    <!-- Tên đăng nhập (chỉ xem) -->
                    <VBox spacing="7.0">
                        <Label styleClass="label-caption" text="TÊN ĐĂNG NHẬP"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrapper">
                            <Label style="-fx-text-fill: #55504A;" text="🔐 "/>
                            <TextField fx:id="txtUsernameDisplay" promptText="Tên đăng nhập"
                                editable="false"
                                styleClass="input-transparent"
                                style="-fx-text-fill: #888888;"
                                HBox.hgrow="ALWAYS"/>
                            <Label text="Không thể sửa"
                                styleClass="label-caption" style="-fx-padding: 0 6 0 0;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Đổi Email -->
                <VBox spacing="14.0" styleClass="card-dark">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="✉" style="-fx-text-fill: #3498db; -fx-font-size: 18px;"/>
                        <Label styleClass="label-section-title" text="ĐỔI ĐỊA CHỈ EMAIL"/>
                    </HBox>
                    <Label text="Email mới sẽ được dùng để liên lạc và thông báo từ hệ thống."
                        styleClass="label-caption" style="-fx-font-size: 11px;" wrapText="true"/>

                    <VBox spacing="7.0">
                        <Label styleClass="label-caption" text="ĐỊA CHỈ EMAIL MỚI"/>
                        <HBox alignment="CENTER_LEFT" styleClass="input-wrapper">
                            <Label style="-fx-text-fill: #3498db;" text="✉ "/>
                            <TextField fx:id="txtNewEmail" promptText="Nhập địa chỉ email mới"
                                styleClass="input-transparent"
                                HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                    <Button maxWidth="Infinity" onAction="#onUpdateEmailClick"
                        styleClass="btn-primary"
                        style="-fx-padding: 11; -fx-font-size: 13px;"
                        text="✉  Cập Nhật Email"/>
                </VBox>

                <!-- Đổi Mật Khẩu -->
                <VBox spacing="14.0" styleClass="card-dark">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="🔒" style="-fx-font-size: 18px;"/>
                        <Label styleClass="label-section-title" text="ĐỔI MẬT KHẨU"/>
                    </HBox>
                    <Label text="Mật khẩu mạnh nên có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và số."
                        styleClass="label-caption" style="-fx-font-size: 11px;" wrapText="true"/>

                    <VBox spacing="10">
                        <VBox spacing="6.0">
                            <Label styleClass="label-caption" text="MẬT KHẨU HIỆN TẠI"/>
                            <HBox alignment="CENTER_LEFT" styleClass="input-wrapper">
                                <Label style="-fx-text-fill: #55504A;" text="🔑 "/>
                                <PasswordField fx:id="txtCurrentPassword" promptText="Nhập mật khẩu hiện tại"
                                    styleClass="input-transparent"
                                    HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="6.0">
                            <Label styleClass="label-caption" text="MẬT KHẨU MỚI (TỐI THIỂU 6 KÝ TỰ)"/>
                            <HBox alignment="CENTER_LEFT" styleClass="input-wrapper">
                                <Label style="-fx-text-fill: #e74c3c;" text="🔒 "/>
                                <PasswordField fx:id="txtNewPassword" promptText="Mật khẩu mới"
                                    styleClass="input-transparent"
                                    HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="6.0">
                            <Label styleClass="label-caption" text="XÁC NHẬN MẬT KHẨU MỚI"/>
                            <HBox alignment="CENTER_LEFT" styleClass="input-wrapper">
                                <Label style="-fx-text-fill: #e74c3c;" text="🔒 "/>
                                <PasswordField fx:id="txtConfirmNewPassword" promptText="Nhập lại mật khẩu mới"
                                    styleClass="input-transparent"
                                    HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                    </VBox>
                    <Button maxWidth="Infinity" onAction="#onChangePasswordClick"
                        styleClass="btn-danger"
                        style="-fx-padding: 11; -fx-font-size: 13px;"
                        text="🔒  Xác Nhận Đổi Mật Khẩu"/>
                </VBox>

                <!-- Thông Báo -->
                <VBox spacing="14.0" styleClass="card-dark">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="🔔" style="-fx-font-size: 18px;"/>
                        <Label styleClass="label-section-title" text="THÔNG BÁO"/>
                    </HBox>
                    <Label text="Tuỳ chỉnh các loại thông báo bạn muốn nhận."
                        styleClass="label-caption" style="-fx-font-size: 11px;" wrapText="true"/>

                    <!-- Outbid Alerts -->
                    <HBox alignment="CENTER_LEFT" spacing="12"
                        style="-fx-background-color: #0E0E14; -fx-border-color: #2D3138; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 16;">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Cảnh báo bị vượt giá"
                                style="-fx-text-fill: #ddd; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label text="Thông báo ngay khi có người đặt giá cao hơn bạn."
                                styleClass="label-caption" style="-fx-font-size: 11px;" wrapText="true"/>
                        </VBox>
                        <ToggleButton fx:id="toggleOutbid" selected="true"
                            style="-fx-background-color: #E8D06E; -fx-background-radius: 20; -fx-min-width: 46; -fx-min-height: 24; -fx-cursor: hand; -fx-text-fill: transparent; -fx-font-size: 0;"
                            onAction="#onToggleNotification"/>
                    </HBox>

                    <!-- Auction Ending Soon -->
                    <HBox alignment="CENTER_LEFT" spacing="12"
                        style="-fx-background-color: #0E0E14; -fx-border-color: #2D3138; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 16;">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Đấu giá sắp kết thúc"
                                style="-fx-text-fill: #ddd; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label text="Nhắc nhở khi phiên đấu giá bạn quan tâm sắp hết giờ."
                                styleClass="label-caption" style="-fx-font-size: 11px;" wrapText="true"/>
                        </VBox>
                        <ToggleButton fx:id="toggleAuctionEnd" selected="true"
                            style="-fx-background-color: #E8D06E; -fx-background-radius: 20; -fx-min-width: 46; -fx-min-height: 24; -fx-cursor: hand; -fx-text-fill: transparent; -fx-font-size: 0;"
                            onAction="#onToggleNotification"/>
                    </HBox>

                    <!-- Exclusive News -->
                    <HBox alignment="CENTER_LEFT" spacing="12"
                        style="-fx-background-color: #0E0E14; -fx-border-color: #2D3138; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 16;">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Tin tức &amp; Ưu đãi độc quyền"
                                style="-fx-text-fill: #ddd; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <Label text="Cập nhật về các phiên đấu giá nổi bật sắp diễn ra."
                                styleClass="label-caption" style="-fx-font-size: 11px;" wrapText="true"/>
                        </VBox>
                        <ToggleButton fx:id="toggleNews" selected="false"
                            style="-fx-background-color: #2D3138; -fx-background-radius: 20; -fx-min-width: 46; -fx-min-height: 24; -fx-cursor: hand; -fx-text-fill: transparent; -fx-font-size: 0;"
                            onAction="#onToggleNotification"/>
                    </HBox>
                </VBox>

                <!-- Toast Label cho feedback -->
                <Label fx:id="lblToast" text="" maxWidth="Infinity"
                    style="-fx-font-size: 12px; -fx-padding: 0 0 10 0; -fx-text-fill: #27ae60;"/>

            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
