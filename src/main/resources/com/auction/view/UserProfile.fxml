<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" style="-fx-background-color: #0A0B0D;"
           stylesheets="@fileCS/style.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.UserProfileController">

    <BorderPane prefHeight="720" prefWidth="500">

        <!-- ===== HEADER ===== -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="navbar-dark" prefHeight="52">
                <Button onAction="#onBackClick" styleClass="btn-back" style="-fx-padding: 4 0;" text="←" />
                <Label styleClass="label-section-title" text="TRANG CÁ NHÂN" />
            </HBox>
        </top>

        <!-- ===== MAIN SCROLL ===== -->
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background: #0A0B0D; -fx-background-color: #0A0B0D; -fx-border-color: transparent;">
                <VBox spacing="0" style="-fx-background-color: #0A0B0D;">

                    <!-- ── Avatar + Name + Badge ── -->
                    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 32 0 24 0; -fx-background-color: #0A0B0D;">
                        <Label fx:id="lblUsername" styleClass="label-section-title" style="-fx-font-size: 20px;" text="Đang tải..." />

                        <!-- Membership badge -->
                        <HBox alignment="CENTER" spacing="6"
                              style="-fx-background-color: #1e1a0e;
                                     -fx-border-color: #8B7536;
                                     -fx-border-radius: 20;
                                     -fx-background-radius: 20;
                                     -fx-padding: 5 16;">
                            <Label styleClass="label-gold" text="★" />
                            <Label fx:id="lblMemberBadge" styleClass="label-gold"
                                   style="-fx-font-size: 11px;"
                                   text="THÀNH VIÊN" />
                        </HBox>
                    </VBox>

                    <!-- ── Membership Tier Card ── -->
                    <VBox style="-fx-padding: 0 20 12 20;">
                        <VBox styleClass="card-dark">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label styleClass="label-caption" text="MEMBERSHIP TIER" />
                                    <Label fx:id="lblTier" styleClass="label-section-title" style="-fx-font-size: 18px;" text="STANDARD" />
                                </VBox>
                                <Label styleClass="label-gold" style="-fx-font-size: 22px;" text="◉" />
                            </HBox>
                            <Region prefHeight="12" />
                            <Label styleClass="label-caption" text="AUCTION LIMIT" />
                            <HBox alignment="BASELINE_LEFT" spacing="6">
                                <Label fx:id="lblAuctionLimit" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" text="—" />
                                <Label styleClass="label-caption" style="-fx-font-size: 13px; -fx-padding: 0 0 3 0;" text="USD" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ── Wallet Balance Card ── -->
                    <VBox style="-fx-padding: 0 20 12 20;">
                        <VBox styleClass="card-dark">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label styleClass="label-caption" text="WALLET BALANCE" />
                                    <Label fx:id="lblBalance" styleClass="label-section-title" style="-fx-font-size: 20px;" text="—" />
                                </VBox>
                                <StackPane prefHeight="36" prefWidth="36"
                                           style="-fx-background-color: #1a1510;
                                                  -fx-background-radius: 8;
                                                  -fx-border-color: #3A2A10;
                                                  -fx-border-radius: 8;">
                                    <Label style="-fx-font-size: 16px;" text="💳" />
                                </StackPane>
                            </HBox>
                            <Region prefHeight="14" />
                            <!-- Deposit / Withdraw Buttons -->
                            <HBox spacing="12">
                                <Button fx:id="btnDeposit" maxWidth="Infinity" onAction="#onGoToDepositClick"
                                        styleClass="btn-gold-luxury"
                                        style="-fx-font-size: 12px; -fx-padding: 10 0;"
                                        text="+ DEPOSIT" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnWithdraw" maxWidth="Infinity" onAction="#onGoToWithdrawClick"
                                        styleClass="btn-outline"
                                        style="-fx-font-size: 12px; -fx-padding: 10 0;"
                                        text="↙ WITHDRAW" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ── Account Management Label ── -->
                    <Label styleClass="label-caption" style="-fx-padding: 8 22 6 22;" text="ACCOUNT MANAGEMENT" />

                    <!-- ── Menu Items Container ── -->
                    <VBox spacing="1" style="-fx-padding: 0 20 0 20;">

                        <!-- Personal Information -->
                        <HBox fx:id="rowPersonalInfo" alignment="CENTER_LEFT" onMouseClicked="#onPersonalInfoClick"
                              spacing="14" styleClass="setting-row">
                            <Label style="-fx-font-size: 16px;" text="👤" />
                            <Label style="-fx-text-fill: #ddd; -fx-font-size: 13px;" text="Personal Information" HBox.hgrow="ALWAYS" />
                            <Label styleClass="label-caption" style="-fx-font-size: 18px;" text="›" />
                        </HBox>

                        <!-- Notifications -->
                        <HBox fx:id="rowNotifications" alignment="CENTER_LEFT" onMouseClicked="#onNotificationsClick"
                              spacing="14" styleClass="setting-row">
                            <Label style="-fx-font-size: 16px;" text="🔔" />
                            <Label style="-fx-text-fill: #ddd; -fx-font-size: 13px;" text="Notifications" HBox.hgrow="ALWAYS" />
                            <StackPane>
                                <Label fx:id="lblNotifDot" styleClass="label-gold" style="-fx-font-size: 9px;" text="●" />
                            </StackPane>
                            <Label styleClass="label-caption" style="-fx-font-size: 18px;" text="›" />
                        </HBox>

                        <!-- Payment Methods (collapsible) -->
                        <VBox fx:id="paymentSection">
                            <HBox fx:id="rowPayment" alignment="CENTER_LEFT" onMouseClicked="#onPaymentMethodsClick"
                                  spacing="14" styleClass="setting-row">
                                <Label style="-fx-font-size: 16px;" text="💳" />
                                <Label style="-fx-text-fill: #ddd; -fx-font-size: 13px;" text="Payment Methods" HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblPaymentChevron" styleClass="label-caption" style="-fx-font-size: 18px;" text="›" />
                            </HBox>

                            <!-- Visa Card Panel (hidden by default) -->
                            <VBox fx:id="visaCardPanel" managed="false"
                                  style="-fx-background-color: #0E0E14;
                                         -fx-border-color: #2D3138;
                                         -fx-border-width: 0 0 1 0;
                                         -fx-padding: 16 18;"
                                  visible="false">
                                <!-- The Visa Card -->
                                <VBox prefHeight="130"
                                      style="-fx-background-color: linear-gradient(to right, #1a1040, #2d1b5e);
                                             -fx-background-radius: 14;
                                             -fx-padding: 18 22;
                                             -fx-effect: dropshadow(gaussian,rgba(100,60,200,0.4),16,0,0,4);">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 22px;" text="◉◉" HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-style: italic;" text="VISA" />
                                    </HBox>
                                    <Region prefHeight="16" />
                                    <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="•••• •••• •••• 4242" />
                                    <Region prefHeight="10" />
                                    <HBox alignment="CENTER_LEFT" spacing="30">
                                        <VBox spacing="2">
                                            <Label style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 9px;" text="CARD HOLDER" />
                                            <Label fx:id="lblCardName" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="—" />
                                        </VBox>
                                        <VBox spacing="2">
                                            <Label style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 9px;" text="EXPIRES" />
                                            <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="12/28" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- Purchase History (collapsible) -->
                        <VBox fx:id="historySection">
                            <HBox fx:id="rowHistory" alignment="CENTER_LEFT" onMouseClicked="#onPurchaseHistoryClick"
                                  spacing="14" styleClass="setting-row" style="-fx-border-width: 0;">
                                <Label style="-fx-font-size: 16px;" text="🕐" />
                                <Label style="-fx-text-fill: #ddd; -fx-font-size: 13px;" text="Purchase History" HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblHistoryChevron" styleClass="label-caption" style="-fx-font-size: 18px;" text="›" />
                            </HBox>

                            <!-- History Panel (hidden by default) -->
                            <VBox fx:id="historyPanel" managed="false" spacing="14"
                                  style="-fx-background-color: #0E0E14; -fx-padding: 18 18 10 18;"
                                  visible="false">

                                <!-- Stats row -->
                                <HBox spacing="10">
                                    <VBox alignment="CENTER" spacing="4" styleClass="card-dark" style="-fx-padding: 14;" HBox.hgrow="ALWAYS">
                                        <Label fx:id="lblTotalBids" styleClass="label-gold" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                                        <Label styleClass="label-caption" text="Lần đặt giá" />
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="4" styleClass="card-dark" style="-fx-padding: 14;" HBox.hgrow="ALWAYS">
                                        <Label fx:id="lblWinCount" style="-fx-text-fill: #27ae60; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                                        <Label styleClass="label-caption" text="Phiên thắng" />
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="4" styleClass="card-dark" style="-fx-padding: 14;" HBox.hgrow="ALWAYS">
                                        <Label fx:id="lblWinRate" style="-fx-text-fill: #3498db; -fx-font-size: 24px; -fx-font-weight: bold;" text="0%" />
                                        <Label styleClass="label-caption" text="Tỉ lệ thắng" />
                                    </VBox>
                                </HBox>

                                <!-- Bid history table -->
                                <VBox spacing="6">
                                    <Label styleClass="label-gold" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="📜  LỊCH SỬ ĐẶT GIÁ" />
                                    <TableView fx:id="tblHistory" prefHeight="220"
                                               style="-fx-background-color: transparent; -fx-border-color: #2D3138; -fx-border-radius: 6;">
                                        <columns>
                                            <TableColumn fx:id="colHisTime" prefWidth="130" text="Thời Gian" />
                                            <TableColumn fx:id="colHisItem" prefWidth="140" text="Sản Phẩm" />
                                            <TableColumn fx:id="colHisAmount" prefWidth="100" text="Số Tiền" />
                                            <TableColumn fx:id="colHisStatus" prefWidth="90" text="Kết Quả" />
                                        </columns>
                                        <placeholder>
                                            <Label styleClass="label-caption" style="-fx-font-style: italic;" text="Chưa có lịch sử đặt giá." />
                                        </placeholder>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </VBox>

                    </VBox>

                    <!-- ── Logout Button ── -->
                    <VBox style="-fx-padding: 24 20 30 20;">
                        <Button maxWidth="Infinity" onAction="#onLogoutClick"
                                styleClass="btn-logout-danger"
                                style="-fx-padding: 13;"
                                text="⎋  Đăng Xuất" />
                    </VBox>

                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>
</StackPane>
